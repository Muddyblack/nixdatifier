#!/usr/bin/env bash
# Usage: dry-run-preview <flake-dir> <input-name> <override-ref> [hostname]
#
# Runs `nix build --dry-run` with the given input overridden to a new revision
# and prints one TSV line per package that would change:
#
#   action<TAB>name<TAB>oldVersion<TAB>newVersion
#
# preceded by one summary line with the cost of the whole update:
#
#   SUMMARY<TAB>downloadBytes<TAB>unpackedBytes<TAB>toBuild<TAB>toFetch
#
# downloadBytes/unpackedBytes are empty when nix printed no parseable size.
# toBuild/toFetch count every derivation/path nix listed, including the
# system-level ones the package lines below leave out.
#
# action = "fetch" (pre-built binary available) | "build" (needs local build)
# oldVersion = currently installed version, or "" if package is new
# newVersion = version from the store path name, or "" if unparseable
#
# NOTE: only downloads the nixpkgs flake source (~20-40 MB, one-time, cached).
# No package binaries are downloaded.

set -u

FLAKE_DIR="${1:-}"
INPUT_NAME="${2:-}"
OVERRIDE_REF="${3:-}"
preview_host="${4:-auto}"

if [ -z "$FLAKE_DIR" ] || [ -z "$INPUT_NAME" ] || [ -z "$OVERRIDE_REF" ]; then
    echo "ERROR: usage: dry-run-preview <flake-dir> <input-name> <override-ref> [hostname]"
    exit 1
fi

export PATH="$PATH:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/root/.nix-profile/bin"

command -v nix >/dev/null 2>&1 || { echo "ERROR: nix not on PATH"; exit 1; }

if [[ "$preview_host" == auto ]]; then
    preview_host=$(hostname -s 2>/dev/null || cat /proc/sys/kernel/hostname)
elif [[ "$preview_host" == single ]]; then
    preview_host=$(nix eval --json --no-write-lock-file "$FLAKE_DIR#nixosConfigurations" --apply builtins.attrNames | jq -er 'if length == 1 then .[0] else error("Host detection disabled: flake must have one NixOS configuration") end') || exit 1
fi

# ── Build a name→version map of the currently running system's packages ───────
declare -A CURRENT_VER
while IFS= read -r storepath; do
    # Strip leading /nix/store/<hash>-. Builtins only: this loop runs once per
    # path in the system closure (thousands), and forking `echo | sed` per
    # line cost ~35 s of CPU on a 5k-path closure. A store hash never contains
    # '-', so dropping everything up to the first '-' removes exactly the hash.
    namever="${storepath##*/}"
    namever="${namever#*-}"
    namever="${namever%.drv}"
    # Split at last numeric component: name-1.2.3 → name + 1.2.3
    if [[ "$namever" =~ ^(.+)-([0-9][^-]*)$ ]]; then
        CURRENT_VER["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
    fi
done < <(nix-store -q --requisites /run/current-system 2>/dev/null | grep -v '\.drv$' | sort -u)

# ── Run the evaluation dry-run ────────────────────────────────────────────────
TARGET="${FLAKE_DIR}#nixosConfigurations.${preview_host}.config.system.build.toplevel"

DRY_OUT=$(nix build --dry-run --no-write-lock-file "$TARGET" \
    --override-input "$INPUT_NAME" "$OVERRIDE_REF" \
    2>&1 1>/dev/null)

EXIT_CODE=$?

# Surface hard evaluation errors
if [ $EXIT_CODE -ne 0 ]; then
    FIRST_ERR=$(echo "$DRY_OUT" | grep -m1 "^error:" || echo "$DRY_OUT" | head -3)
    echo "ERROR: $FIRST_ERR"
    exit 1
fi

# If nix says "nothing to do" (no output), that means everything is up to date
if [ -z "$DRY_OUT" ]; then
    echo "OK: already up to date"
    exit 0
fi

# ── Summarise the cost: sizes from the "will be fetched (…)" header, counts ───
# from the listed paths. The headers look like (singular forms too):
#   these 38 derivations will be built:
#   these 120 paths will be fetched (245.3 MiB download, 1.0 GiB unpacked):
to_bytes() { # to_bytes <number> <unit>
    awk -v n="$1" -v u="$2" 'BEGIN {
        m["B"] = 1; m["KiB"] = 1024; m["MiB"] = 1048576; m["GiB"] = 1073741824; m["TiB"] = 1099511627776
        if (!(u in m)) exit 1
        printf "%.0f", n * m[u] }'
}
size_re='\(([0-9.]+) ([KMGT]?i?B) download, ([0-9.]+) ([KMGT]?i?B) unpacked\)'
TO_BUILD=0 TO_FETCH=0 DL_BYTES=0 UNP_BYTES=0 section=''
while IFS= read -r line; do
    case "$line" in
        *"will be built"*) section=build ;;
        *"will be fetched"*)
            section=fetch
            if [[ "$line" =~ $size_re ]]; then
                DL_BYTES=$(to_bytes "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}") || DL_BYTES=''
                UNP_BYTES=$(to_bytes "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}") || UNP_BYTES=''
            else
                DL_BYTES='' UNP_BYTES=''
            fi ;;
        [[:space:]]*/nix/store/*)
            case "$section" in
                build) TO_BUILD=$((TO_BUILD + 1)) ;;
                fetch) TO_FETCH=$((TO_FETCH + 1)) ;;
            esac ;;
        *) section='' ;;
    esac
done <<< "$DRY_OUT"
printf 'SUMMARY\t%s\t%s\t%s\t%s\n' "$DL_BYTES" "$UNP_BYTES" "$TO_BUILD" "$TO_FETCH"

# ── Parse and emit results ────────────────────────────────────────────────────
SKIP_PATTERNS="^nixos-system-|^nixos-configuration-|^etc-|^system-path$|-man$|-info$|-doc$|-dev$|-lib$"

ACTION="fetch"
while IFS= read -r line; do
    case "$line" in
        *"will be built"*)   ACTION="build" ; continue ;;
        *"will be fetched"*) ACTION="fetch" ; continue ;;
    esac

    # Match store paths: leading whitespace + /nix/store/<hash>-<name>
    if [[ "$line" =~ ^[[:space:]]*/nix/store/[a-z0-9]{32}-(.+)$ ]]; then
        storename="${BASH_REMATCH[1]}"
        storename="${storename%.drv}"

        # Split name-version
        if [[ "$storename" =~ ^(.+)-([0-9][^-]*)$ ]]; then
            pkg_name="${BASH_REMATCH[1]}"
            new_ver="${BASH_REMATCH[2]}"
        else
            pkg_name="$storename"
            new_ver=""
        fi

        # Skip system-level and meta outputs
        [[ "$pkg_name" =~ $SKIP_PATTERNS ]] && continue

        old_ver="${CURRENT_VER[$pkg_name]:-}"

        # Skip if old == new (already installed, just a rebuild artifact)
        [ -n "$old_ver" ] && [ "$old_ver" = "$new_ver" ] && continue

        printf '%s\t%s\t%s\t%s\n' "$ACTION" "$pkg_name" "$old_ver" "$new_ver"
    fi
done <<< "$DRY_OUT" | sort -t$'\t' -k2,2 | uniq
