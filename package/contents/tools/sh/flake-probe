#!/usr/bin/env bash
# Usage: flake-probe <flake-dir>
# Reads <flake-dir>/flake.lock, probes root and wrapper inputs in parallel
# and emits one TSV line per input:
#
#   name<TAB>status<TAB>currentRev<TAB>remoteRev<TAB>currentDate<TAB>url
#       [<TAB>overrideRef<TAB>failure<TAB>remoteDate]
#
# status:
#   ok           — remoteRev differs from currentRev (update available)
#   unchanged    — already on latest
#   pinned       — no revision/hash / unsupported source type
#   unreachable  — git ls-remote failed or timed out
set -u

flake_dir="${1:-}"
lock="$flake_dir/flake.lock"
[ -r "$lock" ] || { echo "ERROR: cannot read $lock" >&2; exit 1; }

export PATH="$PATH:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/root/.nix-profile/bin"

command -v jq  >/dev/null 2>&1 || { echo "ERROR: jq not on PATH"  >&2; exit 1; }
command -v git >/dev/null 2>&1 || { echo "ERROR: git not on PATH" >&2; exit 1; }
have_nix=0
command -v nix >/dev/null 2>&1 && have_nix=1

TIMEOUT="${FLAKE_PROBE_TIMEOUT:-40}"
MAX_PARALLEL="${FLAKE_PROBE_PARALLEL:-8}"
# FLAKE_PROBE_TARBALLS=0 skips tarball inputs; FLAKE_PROBE_DEEP=1 walks every
# transitive input instead of just the root (and a wrapper flake's) inputs.
CHECK_TARBALLS="${FLAKE_PROBE_TARBALLS:-1}"
DEEP="${FLAKE_PROBE_DEEP:-0}"
[ "${NIXDATIFIER_CHECK_TARBALLS:-}" = off ] && CHECK_TARBALLS=0
[ "${NIXDATIFIER_DEEP_INPUTS:-}" = on ] && DEEP=1

# Pull inputs as TSV: name type owner repo url ref rev lastModified narHash lockedUrl
# Use '|' as field separator (tab is whitespace-class in IFS and collapses empty fields).
inputs=$(jq -r --argjson deep "$([ "$DEEP" = 1 ] && echo true || echo false)" '
  . as $l
  | ($l.root // "root") as $rootId
  # Follows are arrays of input names resolved from the root.
  | def res($ref):
      if $ref == null or ($ref | type) == "string" then $ref
      else reduce $ref[] as $k ($rootId; res($l.nodes[.].inputs[$k] // null)) end;
    def children($f):
      ($l.nodes[$f.id].inputs // {}) | to_entries
      | map({name: (if $f.name == "" then .key else $f.name + "/" + .key end),
             id: res(.value), depth: ($f.depth + 1)} | select(.id != null));
    # A wrapper (single root input, or a local path input) carries the real
    # configuration, so its own inputs are checked too. Deep mode walks all.
    def expand($f; $top):
      $deep or $f.depth == 0
      or ($f.depth == 1 and (($top | length) == 1 or ($l.nodes[$f.id].original.type // "") == "path"));
    (children({id: $rootId, name: "", depth: 0})) as $top
  | {seen: {($rootId): true}, frontier: [{id: $rootId, name: "", depth: 0}], out: []}
  # Each pass adds one level; the seen set guarantees it ends, even on cycles.
  | until(.frontier | length == 0;
      reduce (.frontier[] | select(expand(.; $top)) | children(.)[]) as $c (. + {frontier: []};
        if .seen[$c.id] then . else .seen[$c.id] = true | .out += [$c] | .frontier += [$c] end))
  | .out[]
  | . as $e
  | $l.nodes[$e.id] as $n
  | select($n.locked != null and $n.original != null)
  | [
      $e.name,
      ($n.original.type // ""),
      ($n.original.owner // ""),
      ($n.original.repo // ""),
      ($n.original.url // ""),
      ($n.original.ref // ""),
      ($n.locked.rev // ""),
      ($n.locked.lastModified // 0 | tostring),
      ($n.locked.narHash // ""),
      ($n.locked.url // "")
    ] | join("|")
' "$lock" 2>/dev/null) || { echo "ERROR: failed to parse flake.lock" >&2; exit 1; }

[ -z "$inputs" ] && exit 0

# Nix appends its own bookkeeping (lastModified, narHash, ...) to locked tarball
# URLs. Drop only those, so a server's own query parameters still tell versions apart.
strip_nix_params() {
    local base="${1%%[?#]*}" query="" kept="" p
    [[ "$1" == *\?* ]] && query="${1#*\?}" && query="${query%%#*}"
    local IFS='&'
    for p in $query; do
        case "$p" in lastModified=* | narHash=* | rev=* | revCount=*) ;; *) kept+="${kept:+&}$p" ;; esac
    done
    printf '%s%s' "$base" "${kept:+?$kept}"
}

# Value of one query parameter of a URL (empty when absent).
url_param() {
    local query="" p
    [[ "$1" == *\?* ]] || return 0
    query="${1#*\?}"; query="${query%%#*}"
    local IFS='&'
    for p in $query; do
        [[ "$p" == "$2="* ]] && { printf '%s' "${p#*=}"; return 0; }
    done
}

# Git revision of a channel archive: the rev= Nix and the channel server put on
# the immutable URL, else the <channel>.<count>.<shortrev> directory name.
channel_rev() {
    local rev dir
    rev=$(url_param "$1" rev)
    [[ "$rev" =~ ^[[:xdigit:]]{7,40}$ ]] && { printf '%s' "$rev"; return 0; }
    dir="${1%%[?#]*}"; dir="${dir%/*}"; dir="${dir##*/}"
    [[ "$dir" =~ \.([[:xdigit:]]{7,40})$ ]] && printf '%s' "${BASH_REMATCH[1]}"
    return 0
}

probe_one() {
    local name="$1" type="$2" owner="$3" repo="$4" url="$5" ref="$6" rev="$7" date="$8" nar_hash="$9" locked_url="${10}"
    local remote_url=""

    case "$type" in
        tarball)
            # Tarball locks often have no Git revision. Let Nix resolve the
            # original URL (including redirects and compression) and compare
            # the unpacked content hash rather than guessing a Git remote.
            local metadata="" latest_hash="" latest_rev="" latest_url="" latest_ts="" status="unchanged" fields=""
            # Older locks of channel archives carry no rev; recover it from the URL.
            [[ -n "$rev" ]] || rev=$(channel_rev "$locked_url")
            rev="${rev:-$nar_hash}"
            if [[ "$CHECK_TARBALLS" != 1 ]]; then
                printf '%s\tpinned\t%s\t\t%s\t%s\n' "$name" "$rev" "$date" "$url"
                return
            fi
            # Cheap path: Nix locks the immutable URL a mutable one (a channel)
            # redirects to, so a HEAD request tells us if it moved - no download.
            if [[ -n "$locked_url" ]] && command -v curl >/dev/null 2>&1; then
                local hdr="" immutable="" effective="" lm=""
                # --fail: an HTTP error or a dead connection means "don't know", never "changed".
                if hdr=$(curl --silent --fail --head --location --max-time 15 --connect-timeout 5 \
                    -o /dev/null -D - -w '\n__EFFECTIVE__%{url_effective}\n' "$url" 2>/dev/null); then
                    hdr=${hdr//$'\r'/}
                    # Only the server's own immutable marker (what Nix trusts) can prove an update.
                    immutable=$(sed -n 's/^[Ll]ink:[[:space:]]*<\([^>]*\)>;.*rel="\{0,1\}immutable.*/\1/p' <<< "$hdr" | tail -1)
                    effective=$(sed -n 's/^__EFFECTIVE__//p' <<< "$hdr" | tail -1)
                    lm=$(sed -n 's/^[Ll]ast-[Mm]odified:[[:space:]]*//p' <<< "$hdr" | tail -1)
                    if [[ -z "$immutable" && "$(strip_nix_params "$effective")" == "$(strip_nix_params "$locked_url")" ]]; then
                        immutable=$effective # landed exactly on the locked archive
                    fi
                fi
                if [[ -n "$immutable" ]]; then
                    if [[ "$(strip_nix_params "$immutable")" == "$(strip_nix_params "$locked_url")" ]]; then
                        printf '%s\tunchanged\t%s\t%s\t%s\t%s\t\n' "$name" "$rev" "$rev" "$date" "$url"
                    else
                        local new_rev new_ts
                        new_rev=$(channel_rev "$immutable")
                        if [[ -z "$new_rev" ]]; then # not a channel: name the archive
                            new_rev="${immutable%%[?#]*}"; new_rev="${new_rev%/*}"; new_rev="${new_rev##*/}"
                        fi
                        # The lastModified Nix will lock; the archive's upload time otherwise.
                        new_ts=$(url_param "$immutable" lastModified)
                        [[ "$new_ts" =~ ^[0-9]+$ ]] || new_ts=""
                        [[ -z "$new_ts" && -n "$lm" ]] && new_ts=$(date -d "$lm" +%s 2>/dev/null || true)
                        printf '%s\tok\t%s\t%s\t%s\t%s\t%s\t\t%s\n' "$name" "$rev" "$new_rev" "$date" "$url" "$immutable" "$new_ts"
                    fi
                    return
                fi
            fi
            if [[ -z "$nar_hash" || -z "$url" ]]; then
                printf '%s\tpinned\t%s\t\t%s\t%s\n' "$name" "$rev" "$date" "$url"
                return
            fi
            if (( have_nix )) && metadata=$(timeout --kill-after=2s "$TIMEOUT" nix flake metadata \
                --refresh --json --no-write-lock-file "$url" 2>/dev/null); then
                # Parse once per archive, preserving empty fields.
                fields=$(jq -er '
                    .locked | select(.narHash | type == "string" and length > 0)
                    | [.narHash, (.rev // .narHash), (.url // ""), (.lastModified // "" | tostring)] | join("|")
                ' <<< "$metadata" 2>/dev/null) || fields=""
                IFS='|' read -r latest_hash latest_rev latest_url latest_ts <<< "$fields"
            fi
            if [[ -z "$latest_hash" ]]; then
                local why="Could not resolve tarball metadata with Nix (timeout, fetch failure or invalid metadata)"
                (( have_nix )) || why="nix not on PATH"
                printf '%s\tunreachable\t%s\t\t%s\t%s\t\t%s\n' \
                    "$name" "$rev" "$date" "$url" "$why"
            else
                [[ "$latest_hash" == "$nar_hash" ]] || status="ok"
                [[ "$latest_rev" == "$latest_hash" ]] && latest_rev=$(channel_rev "$latest_url")
                printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t\t%s\n' \
                    "$name" "$status" "$rev" "${latest_rev:-$latest_hash}" "$date" "$url" "${latest_url:-$url}" "$latest_ts"
            fi
            return
            ;;
        github)    remote_url="https://github.com/${owner}/${repo}.git" ;;
        gitlab)    remote_url="https://gitlab.com/${owner}/${repo}.git" ;;
        sourcehut) remote_url="https://git.sr.ht/${owner}/${repo}" ;;
        git)
            remote_url="$url"
            [[ "$remote_url" == git+* ]] && remote_url="${remote_url#git+}"
            ;;
        *)
            printf '%s\t%s\t%s\t\t%s\t\n' "$name" "pinned" "$rev" "$date"
            return
            ;;
    esac

    if [ -z "$rev" ]; then
        printf '%s\t%s\t%s\t\t%s\t%s\n' "$name" "pinned" "$rev" "$date" "$remote_url"
        return
    fi

    local refs=()
    if [ -n "$ref" ]; then
        refs=("refs/heads/$ref" "refs/tags/$ref" "$ref")
    else
        refs=("HEAD")
    fi

    local remote_rev="" remote_output="" failure="" result=0
    # Git's ref advertisement is expensive for repositories such as nixpkgs.
    # Ask GitHub for just the target commit (per_page=1 keeps out the file
    # list a single-commit lookup carries); its sha and commit date come in one
    # request. Retain Git for API rate limits, private repositories, and
    # installations without curl - those updates simply have no date.
    local remote_ts=""
    if [[ "$type" == github ]] && command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        local encoded_ref api_json
        encoded_ref=$(jq -rn --arg ref "${ref:-}" '$ref | @uri')
        api_json=$(curl --fail --silent --show-error --location \
            --connect-timeout 5 --max-time 15 \
            -H 'Accept: application/vnd.github+json' \
            "https://api.github.com/repos/${owner}/${repo}/commits?per_page=1${encoded_ref:+&sha=$encoded_ref}" 2>/dev/null) || api_json=""
        remote_rev=$(jq -r '.[0].sha // empty' <<< "$api_json" 2>/dev/null) || remote_rev=""
        [[ "$remote_rev" =~ ^[[:xdigit:]]{40}$ ]] || remote_rev=""
        if [[ -n "$remote_rev" ]]; then
            # Same value Nix stores as lastModified: the commit date.
            remote_ts=$(jq -r '.[0].commit.committer.date // empty | fromdateiso8601' <<< "$api_json" 2>/dev/null) || remote_ts=""
            [[ "$remote_ts" =~ ^[0-9]+$ ]] || remote_ts=""
        fi
    fi
    if [[ -z "$remote_rev" ]]; then
        remote_output=$(GIT_TERMINAL_PROMPT=0 timeout --kill-after=2s "$TIMEOUT" \
            git -c protocol.version=2 ls-remote --quiet "$remote_url" "${refs[@]}" 2>&1) || result=$?
        if (( result == 0 )); then
            remote_rev=$(awk 'NR==1 {print $1}' <<< "$remote_output")
            failure="Requested branch or tag was not found"
        elif [[ "$remote_output" == *"Could not resolve host"* || "$remote_output" == *"Could not resolve hostname"* ]]; then
            failure="DNS lookup failed"
        elif (( result == 124 || result == 137 )); then
            failure="Git request timed out after ${TIMEOUT}s"
        else
            failure="Git request failed (exit ${result})"
        fi
        [[ "$remote_rev" =~ ^[[:xdigit:]]{40}$ ]] || remote_rev=""
    fi

    # Build the --override-input flake ref for the dry-run preview feature.
    local override_ref=""
    case "$type" in
        github)    override_ref="github:${owner}/${repo}/${remote_rev}" ;;
        gitlab)    override_ref="gitlab:${owner}/${repo}/${remote_rev}" ;;
        sourcehut) override_ref="sourcehut:${owner}/${repo}/${remote_rev}" ;;
        git)
            local base="$url"
            [[ "$base" == git+* ]] && base="${base#git+}"
            base="${base%.git}"
            override_ref="${base}?rev=${remote_rev}"
            ;;
    esac

    if [ -z "$remote_rev" ]; then
        printf '%s\t%s\t%s\t\t%s\t%s\t\t%s\n' "$name" "unreachable" "$rev" "$date" "$remote_url" "$failure"
    elif [ "$remote_rev" = "$rev" ]; then
        printf '%s\t%s\t%s\t%s\t%s\t%s\t\n' "$name" "unchanged" "$rev" "$remote_rev" "$date" "$remote_url"
    else
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t\t%s\n' "$name" "ok" "$rev" "$remote_rev" "$date" "$remote_url" "$override_ref" "$remote_ts"
    fi
}

# Concurrency throttle via a job slot
running=0
while IFS='|' read -r name type owner repo url ref rev date nar_hash locked_url; do
    [ -z "$name" ] && continue
    probe_one "$name" "$type" "$owner" "$repo" "$url" "$ref" "$rev" "$date" "$nar_hash" "$locked_url" &
    running=$((running + 1))
    if [ "$running" -ge "$MAX_PARALLEL" ]; then
        wait -n 2>/dev/null || wait
        running=$((running - 1))
    fi
done <<< "$inputs"

wait
exit 0
