#!/usr/bin/env bash
# Usage: flake-probe <flake-dir>
# Reads <flake-dir>/flake.lock, probes each root input's remote in parallel
# and emits one TSV line per input:
#
#   name<TAB>status<TAB>currentRev<TAB>remoteRev<TAB>currentDate<TAB>url
#
# status:
#   ok           — remoteRev differs from currentRev (update available)
#   unchanged    — already on latest
#   pinned       — no revision/hash / unsupported source type
#   unreachable  — git ls-remote failed or timed out
set -u

flake_dir="${1:-}"
lock="$flake_dir/flake.lock"
[ -r "$lock" ] || { echo "ERROR: cannot read $lock" >&2; exit 1; }

export PATH="$PATH:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/root/.nix-profile/bin"

command -v jq  >/dev/null 2>&1 || { echo "ERROR: jq not on PATH"  >&2; exit 1; }
command -v git >/dev/null 2>&1 || { echo "ERROR: git not on PATH" >&2; exit 1; }

TIMEOUT="${FLAKE_PROBE_TIMEOUT:-40}"
MAX_PARALLEL="${FLAKE_PROBE_PARALLEL:-8}"

# Pull root inputs as TSV: name type owner repo url ref rev lastModified
# Use '|' as field separator (tab is whitespace-class in IFS and collapses empty fields).
inputs=$(jq -r '
  .nodes[.root // "root"].inputs as $ri
  | ($ri | to_entries[]) as $e
  | .nodes[($e.value | if type=="string" then . else .[0] end)] as $n
  | select($n.locked != null and $n.original != null)
  | [
      $e.key,
      ($n.original.type // ""),
      ($n.original.owner // ""),
      ($n.original.repo // ""),
      ($n.original.url // ""),
      ($n.original.ref // ""),
      ($n.locked.rev // ""),
      ($n.locked.lastModified // 0 | tostring),
      ($n.locked.narHash // "")
    ] | join("|")
' "$lock" 2>/dev/null) || { echo "ERROR: failed to parse flake.lock" >&2; exit 1; }

[ -z "$inputs" ] && exit 0

probe_one() {
    local name="$1" type="$2" owner="$3" repo="$4" url="$5" ref="$6" rev="$7" date="$8" nar_hash="$9"
    local remote_url=""

    case "$type" in
        tarball)
            # Tarball locks often have no Git revision. Let Nix resolve the
            # original URL (including redirects and compression) and compare
            # the unpacked content hash rather than guessing a Git remote.
            local metadata="" latest_hash="" latest_rev="" latest_url="" status="unchanged"
            rev="${rev:-$nar_hash}"
            if [[ -z "$nar_hash" || -z "$url" ]]; then
                printf '%s\tpinned\t%s\t\t%s\t%s\n' "$name" "$rev" "$date" "$url"
                return
            fi
            if metadata=$(timeout --kill-after=2s "$TIMEOUT" nix flake metadata \
                --refresh --json --no-write-lock-file "$url" 2>/dev/null); then
                latest_hash=$(jq -r '.locked.narHash // empty' <<< "$metadata" 2>/dev/null)
                latest_rev=$(jq -r '.locked.rev // .locked.narHash // empty' <<< "$metadata" 2>/dev/null)
                latest_url=$(jq -r '.locked.url // empty' <<< "$metadata" 2>/dev/null)
            fi
            if [[ -z "$latest_hash" ]]; then
                printf '%s\tunreachable\t%s\t\t%s\t%s\t\t%s\n' \
                    "$name" "$rev" "$date" "$url" "Could not resolve tarball metadata with Nix (timeout, fetch failure or invalid metadata)"
            else
                [[ "$latest_hash" == "$nar_hash" ]] || status="ok"
                printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                    "$name" "$status" "$rev" "$latest_rev" "$date" "$url" "${latest_url:-$url}"
            fi
            return
            ;;
        github)    remote_url="https://github.com/${owner}/${repo}.git" ;;
        gitlab)    remote_url="https://gitlab.com/${owner}/${repo}.git" ;;
        sourcehut) remote_url="https://git.sr.ht/${owner}/${repo}" ;;
        git)
            remote_url="$url"
            [[ "$remote_url" == git+* ]] && remote_url="${remote_url#git+}"
            ;;
        *)
            printf '%s\t%s\t%s\t\t%s\t\n' "$name" "pinned" "$rev" "$date"
            return
            ;;
    esac

    if [ -z "$rev" ]; then
        printf '%s\t%s\t%s\t\t%s\t%s\n' "$name" "pinned" "$rev" "$date" "$remote_url"
        return
    fi

    local refs=()
    if [ -n "$ref" ]; then
        refs=("refs/heads/$ref" "refs/tags/$ref" "$ref")
    else
        refs=("HEAD")
    fi

    local remote_rev="" remote_output="" failure="" result=0
    # Git's ref advertisement is expensive for repositories such as nixpkgs.
    # Ask GitHub for just the target commit; retain Git for API rate limits,
    # private repositories, and installations without curl.
    if [[ "$type" == github ]] && command -v curl >/dev/null 2>&1; then
        local encoded_ref
        encoded_ref=$(jq -rn --arg ref "${ref:-HEAD}" '$ref | @uri')
        remote_rev=$(curl --fail --silent --show-error --location \
            --connect-timeout 5 --max-time 15 \
            -H 'Accept: application/vnd.github.sha' \
            "https://api.github.com/repos/${owner}/${repo}/commits/${encoded_ref}" 2>/dev/null) || remote_rev=""
        [[ "$remote_rev" =~ ^[[:xdigit:]]{40}$ ]] || remote_rev=""
    fi
    if [[ -z "$remote_rev" ]]; then
        remote_output=$(GIT_TERMINAL_PROMPT=0 timeout --kill-after=2s "$TIMEOUT" \
            git -c protocol.version=2 ls-remote --quiet "$remote_url" "${refs[@]}" 2>&1) || result=$?
        if (( result == 0 )); then
            remote_rev=$(awk 'NR==1 {print $1}' <<< "$remote_output")
            failure="Requested branch or tag was not found"
        elif [[ "$remote_output" == *"Could not resolve host"* || "$remote_output" == *"Could not resolve hostname"* ]]; then
            failure="DNS lookup failed"
        elif (( result == 124 || result == 137 )); then
            failure="Git request timed out after ${TIMEOUT}s"
        else
            failure="Git request failed (exit ${result})"
        fi
        [[ "$remote_rev" =~ ^[[:xdigit:]]{40}$ ]] || remote_rev=""
    fi

    # Build the --override-input flake ref for the dry-run preview feature.
    local override_ref=""
    case "$type" in
        github)    override_ref="github:${owner}/${repo}/${remote_rev}" ;;
        gitlab)    override_ref="gitlab:${owner}/${repo}/${remote_rev}" ;;
        sourcehut) override_ref="sourcehut:${owner}/${repo}/${remote_rev}" ;;
        git)
            local base="$url"
            [[ "$base" == git+* ]] && base="${base#git+}"
            base="${base%.git}"
            override_ref="${base}?rev=${remote_rev}"
            ;;
    esac

    if [ -z "$remote_rev" ]; then
        printf '%s\t%s\t%s\t\t%s\t%s\t\t%s\n' "$name" "unreachable" "$rev" "$date" "$remote_url" "$failure"
    elif [ "$remote_rev" = "$rev" ]; then
        printf '%s\t%s\t%s\t%s\t%s\t%s\t\n' "$name" "unchanged" "$rev" "$remote_rev" "$date" "$remote_url"
    else
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "ok" "$rev" "$remote_rev" "$date" "$remote_url" "$override_ref"
    fi
}

# Concurrency throttle via a job slot
running=0
while IFS='|' read -r name type owner repo url ref rev date nar_hash; do
    [ -z "$name" ] && continue
    probe_one "$name" "$type" "$owner" "$repo" "$url" "$ref" "$rev" "$date" "$nar_hash" &
    running=$((running + 1))
    if [ "$running" -ge "$MAX_PARALLEL" ]; then
        wait -n 2>/dev/null || wait
        running=$((running - 1))
    fi
done <<< "$inputs"

wait
exit 0
