#!/usr/bin/env bash
# Usage: devenv discover
#        devenv inspect <project-dir>
#        devenv shells <project-dir>
#        devenv shellpkgs <project-dir> <shell-name>
#        devenv space
#        devenv clear <project-dir>
#
# Describes development environments (direnv, Nix flakes, shell.nix, devenv).
# Works on any distro; nothing here needs NixOS. Everything except `clear` is
# read-only and offline: no .envrc is executed and nothing is fetched.
#
# discover   one "<dir>\t<state>" line per project direnv already knows
#            (state: allowed | denied), newest first.
# inspect    fast (no Nix evaluation). Four \x1e-separated fields:
#              [0] key=value metadata lines
#              [1] the first lines of the .envrc
#              [2] flake.lock root inputs, TSV: name type source ref rev lastModified follows
#              [3] reserved (empty); use `shells` for devShells
# shells     devShell names the flake exposes for this system, one per line.
#            Evaluates the flake, so it is slow and bounded. Exit 3 if it fails.
# shellpkgs  package names inside one devShell, one per line.
# space      "<dir>\t<bytes>\t<closure|files>\t<mtime>" per project that has a
#            .direnv cache, largest first. Closure sizes count store paths shared
#            with other projects in each of them.
# clear      removes <dir>/.direnv (a cache direnv rebuilds), freeing its GC roots.
set -u
export PATH="$PATH:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:${HOME:-/root}/.nix-profile/bin"

data_home="${XDG_DATA_HOME:-${HOME:-/root}/.local/share}"

lowprio() {
    if command -v ionice >/dev/null 2>&1; then
        nice -n 19 ionice -c 3 "$@"
    else
        nice -n 19 "$@"
    fi
}

resolve() {
    local dir="$1"
    # shellcheck disable=SC2088  # a literal "~", not an expansion
    [[ "$dir" == "~" || "$dir" == "~/"* ]] && dir="${HOME:-/root}${dir#\~}"
    realpath -m -- "$dir" 2>/dev/null || printf '%s' "$1"
}

# One `find` and shell builtins only: direnv users can have dozens of entries,
# and a process per entry made this the slowest call in the widget.
discover() {
    local state stamp file rc
    for state in allow deny; do
        [ -d "$data_home/direnv/$state" ] || continue
        while IFS=$'\t' read -r stamp file; do
            IFS= read -r rc < "$file" 2>/dev/null || continue
            [[ "$rc" == /* && -f "$rc" ]] || continue
            printf '%s\t%s\t%s\n' "${stamp%.*}" "${rc%/*}" "$([ "$state" = allow ] && echo allowed || echo denied)"
        done < <(find "$data_home/direnv/$state" -maxdepth 1 -type f -printf '%T@\t%p\n' 2>/dev/null)
    done | sort -rn | awk -F'\t' '!seen[$2]++ {print $2 "\t" $3}'
}

inspect() {
    local dir
    dir=$(resolve "$1")
    [ -d "$dir" ] || { echo "ERROR: not a directory: $1" >&2; exit 2; }
    cd -- "$dir" || exit 2

    local kv=() envrc="" rc_path="" rc_state="none"
    kv+=("dir=$dir" "name=$(basename -- "$dir")")

    # ── direnv ────────────────────────────────────────────────────────────────
    if command -v direnv >/dev/null 2>&1; then
        kv+=("direnv=$(direnv version 2>/dev/null | head -n 1)")
        # `direnv status` only reads: it never evaluates the .envrc. It also
        # walks up the tree, exactly like the shell hook does.
        local status
        status=$(direnv status 2>/dev/null)
        rc_path=$(printf '%s\n' "$status" | sed -n 's/^Found RC path //p' | head -n 1)
        case "$(printf '%s\n' "$status" | sed -n 's/^Found RC allowed //p' | head -n 1)" in
            0 | true) rc_state=allowed ;;
            1 | false) rc_state=blocked ;;
            2) rc_state=denied ;;
        esac
    else
        kv+=("direnv=")
        # Without direnv we can still tell whether the folder is set up for it.
        local up="$dir"
        while [ "$up" != "/" ]; do
            [ -f "$up/.envrc" ] && { rc_path="$up/.envrc"; rc_state=unknown; break; }
            up=$(dirname -- "$up")
        done
    fi
    kv+=("envrc_path=$rc_path" "envrc_state=$rc_state")

    if [ -n "$rc_path" ] && [ -r "$rc_path" ]; then
        envrc=$(head -n 24 -- "$rc_path" 2>/dev/null)
        # Which environment providers the .envrc asks for.
        local uses=() word
        for word in "use flake" "use nix" "use devenv" "use asdf" "use mise" "layout python" "layout node" "layout poetry" "dotenv" "source_env" "watch_file"; do
            grep -Eq "^[[:space:]]*${word}([[:space:]]|\$)" "$rc_path" 2>/dev/null && uses+=("$word")
        done
        local IFS=,
        kv+=("envrc_uses=${uses[*]:-}")
        unset IFS
    else
        kv+=("envrc_uses=")
    fi

    # ── cached environment (nix-direnv / direnv layouts) ──────────────────────
    local layout="${rc_path:+$(dirname -- "$rc_path")}"
    layout="${layout:-$dir}/.direnv"
    if [ -d "$layout" ]; then
        local newest
        newest=$(find "$layout" -maxdepth 2 -type l -printf '%T@\n' 2>/dev/null | sort -rn | head -n 1)
        newest="${newest%.*}"
        kv+=("cache_dir=$layout" "cache_mtime=${newest:-$(stat -c %Y "$layout")}")
        kv+=("cache_size=$(du -sk "$layout" 2>/dev/null | cut -f1)")
    else
        kv+=("cache_dir=" "cache_mtime=" "cache_size=")
    fi

    # ── project files ─────────────────────────────────────────────────────────
    local files=() f
    for f in flake.nix flake.lock shell.nix default.nix devenv.nix devenv.yaml devbox.json mise.toml .tool-versions .envrc .env Dockerfile compose.yaml; do
        [ -e "$f" ] && files+=("$f")
    done
    local IFS=,
    kv+=("files=${files[*]:-}")
    unset IFS

    # ── flake ─────────────────────────────────────────────────────────────────
    local description=""
    if [ -f flake.nix ]; then
        description=$(sed -n 's/^[[:space:]]*description[[:space:]]*=[[:space:]]*"\(.*\)";.*/\1/p' flake.nix | head -n 1)
    fi
    kv+=("description=$description")

    local locks="" lock_count=0 lock_oldest="" lock_newest=""
    if [ -f flake.lock ] && command -v jq >/dev/null 2>&1; then
        locks=$(jq -r '
            . as $l
            | ($l.nodes.root.inputs // {}) | to_entries[]
            | . as $e
            | (if ($e.value | type) == "array" then null else $l.nodes[$e.value] end) as $n
            | [
                $e.key,
                (if $n == null then "follows" else ($n.locked.type // "") end),
                (if $n == null then ""
                 elif $n.original.owner then "\($n.original.owner)/\($n.original.repo // "")"
                 else ($n.original.url // $n.original.path // $n.original.repo // "") end),
                (if $n == null then "" else ($n.original.ref // "") end),
                (if $n == null then "" else (($n.locked.rev // "")[0:7]) end),
                (if $n == null then "0" else (($n.locked.lastModified // 0) | tostring) end),
                (if ($e.value | type) == "array" then ($e.value | join("/")) else "" end)
              ] | @tsv' flake.lock 2>/dev/null)
        lock_count=$(printf '%s' "$locks" | grep -c . || true)
        lock_oldest=$(printf '%s\n' "$locks" | awk -F'\t' '$6 > 0 {print $6}' | sort -n | head -n 1)
        lock_newest=$(printf '%s\n' "$locks" | awk -F'\t' '$6 > 0 {print $6}' | sort -n | tail -n 1)
    fi
    kv+=("lock_inputs=$lock_count" "lock_oldest=$lock_oldest" "lock_newest=$lock_newest")

    printf '%s\n' "${kv[@]}"
    printf '\x1e%s' "$envrc"
    printf '\x1e%s' "$locks"
    printf '\x1e'
}

# Evaluating a flake can be slow on a cold cache, so it is bounded and never
# allowed to touch the network.
shells() {
    local dir
    dir=$(resolve "$1")
    [ -d "$dir" ] || { echo "ERROR: not a directory: $1" >&2; exit 2; }
    cd -- "$dir" || exit 2
    [ -f flake.nix ] || exit 0
    command -v nix >/dev/null 2>&1 || exit 3
    local out
    out=$(timeout --kill-after=2s 25s nix eval --offline --json ".#devShells.$(uname -m)-linux" --apply builtins.attrNames 2>/dev/null) || exit 3
    printf '%s' "$out" | jq -r '.[]' 2>/dev/null
}

shellpkgs() {
    local dir name
    dir=$(resolve "$1")
    name="${2:-}"
    [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "ERROR: invalid shell name" >&2; exit 2; }
    [ -d "$dir" ] || { echo "ERROR: not a directory: $1" >&2; exit 2; }
    cd -- "$dir" || exit 2
    command -v nix >/dev/null 2>&1 || exit 3
    local out
    out=$(timeout --kill-after=2s 30s nix eval --offline --json ".#devShells.$(uname -m)-linux.\"$name\"" \
        --apply 'd: map (p: p.name or (p.pname or "?")) ((d.buildInputs or []) ++ (d.nativeBuildInputs or []))' 2>/dev/null) || exit 3
    printf '%s' "$out" | jq -r '.[]' 2>/dev/null | sort -u
}

# Measures every direnv project with a cache, four at a time at idle priority.
space() {
    local n=0 dir
    # Not local: the EXIT trap runs after this function has returned.
    tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/nixdatifier-space.XXXXXXXX") || exit 1
    trap 'rm -rf -- "$tmp"' EXIT
    while IFS= read -r dir; do
        [ -d "$dir/.direnv" ] || continue
        measure_one "$dir" > "$tmp/$n" &
        n=$((n + 1))
        (( n % 4 == 0 )) && wait
    done < <(discover | cut -f1 | head -n 40)
    wait
    cat "$tmp"/* 2>/dev/null | sort -t$'\t' -k2 -rn
}

measure_one() {
    local dir="$1" layout="$1/.direnv" link bytes="" kind=closure
    link=$(find "$layout" -maxdepth 1 -type l -name 'flake-profile-*' ! -name '*.rc' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n 1 | cut -d' ' -f2-)
    if [ -n "$link" ] && command -v nix >/dev/null 2>&1; then
        bytes=$(lowprio nix path-info -S "$link" 2>/dev/null | awk '{print $NF}')
    fi
    if [ -z "$bytes" ]; then
        bytes=$(( $(du -sk "$layout" 2>/dev/null | cut -f1) * 1024 ))
        kind=files
    fi
    printf '%s\t%s\t%s\t%s\n' "$dir" "$bytes" "$kind" "$(stat -c %Y "$layout")"
}

clear_cache() {
    local dir
    dir=$(resolve "$1")
    # Only ever remove the cache of a folder that is a direnv project.
    if [ -d "$dir/.direnv" ] && [ -f "$dir/.envrc" ]; then
        rm -rf -- "$dir/.direnv"
    else
        echo "ERROR: no direnv cache to clear in $1" >&2
        exit 2
    fi
}

case "${1:-}" in
    discover) discover ;;
    inspect) inspect "${2:?missing project directory}" ;;
    shells) shells "${2:?missing project directory}" ;;
    shellpkgs) shellpkgs "${2:?missing project directory}" "${3:?missing shell name}" ;;
    space) space ;;
    clear) clear_cache "${2:?missing project directory}" ;;
    *) echo "usage: devenv discover | inspect <dir> | shells <dir> | shellpkgs <dir> <name> | space | clear <dir>" >&2; exit 2 ;;
esac
