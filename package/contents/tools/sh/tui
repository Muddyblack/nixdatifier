#!/usr/bin/env bash
# nixdatifier tui: the interactive front end, in the spirit of lazygit. A bare
# `nixdatifier` (or `nixdatifier menu`) on a terminal opens it.
#
# It owns no system logic. Every list, preview and action calls the nixdatifier
# CLI, so locks, cache, history and confirmation prompts stay in one place; this
# file only arranges them in fzf screens. fzf calls back into it through the
# `_name` endpoints at the bottom for lists and previews. Without fzf 0.70 or
# newer (or with NIXDATIFIER_NO_FZF=1) it falls back to a numbered menu.
#
# Keys everywhere: Enter opens, Esc or Backspace (on an empty search) goes back,
# Ctrl-R refreshes, Ctrl-/ toggles the preview, F1 lists the keys. With the mouse,
# right-click goes back, and clicking a key in the footer presses it.
set -uo pipefail
here=$(dirname "$(realpath "$0")")
export NXD_CLI=${NXD_CLI:-$here/nixdatifier} NXD_TUI=${NXD_TUI:-$here/tui}
# The screens are laid out as a whole; personal fzf defaults (height, border,
# layout) would break them.
unset FZF_DEFAULT_OPTS FZF_DEFAULT_OPTS_FILE FZF_DEFAULT_COMMAND
FZF_MIN=0.70
: "${NXD_STATE:=${TMPDIR:-/tmp}}" "${NXD_CACHE:=$NXD_STATE}"

# ── Look ────────────────────────────────────────────────────────────────────
# Two independent choices, kept in ~/.config/nixdatifier/tui.conf and switched on
# the home screen with Alt-C (colour) and Alt-L (layout), or by clicking them in
# the footer. The starting choice can come from the environment
# (NIXDATIFIER_THEME, NIXDATIFIER_LAYOUT; the Nix modules' tui.theme/tui.layout);
# a choice made in the view is remembered and wins.
#   layout  roomy (default: boxed sections, the logo) or compact (no boxes)
#   theme   a name. Built in: deep (default), midnight, marina, full, plain. Your
#           own: a file NAME.theme in ~/.config/nixdatifier/themes (or
#           /etc/nixdatifier/themes) with lines "key=#rrggbb"; see docs/cli.md.
#           It overrides a built-in of the same name; keys left out keep the
#           deep theme's value. NO_COLOR always means plain.
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/nixdatifier/tui.conf
THEME_DIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/nixdatifier/themes" /etc/nixdatifier/themes)
conf_get() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -1; }

# Built-in themes: accent label text muted border select match pointer ok bad
# warn bg (empty bg: the terminal's own). full also has orange pink violet cyan.
declare -A T
theme_defaults() {
    T=([accent]='#0EADCF' [label]='#22D4FF' [text]='#CBE0F0' [muted]='#8295A0' [border]='#336380' [select]='#074F81'
        [match]='#55FFCC' [pointer]='#47FF9C' [ok]='#44FFB1' [bad]='#E52E2E' [warn]='#FFE073' [bg]='#02162B')
}
theme_builtin() { # theme_builtin NAME
    case $1 in
        midnight) T[bg]='#03233A' ;; # Midnight Marina; deep is Midnight Marina Deep
        marina) # the widget's Theme.qml
            T=([accent]='#91bcff' [label]='#91bcff' [text]='#e6ecf5' [muted]='#939fb2' [border]='#2c384b' [select]='#243247'
                [match]='#91bcff' [pointer]='#91bcff' [ok]='#6ee7b7' [bad]='#fb858f' [warn]='#f2cc70' [bg]='') ;;
        full) # the logo's gradient on everything
            T=([accent]='#ff4fd8' [label]='#ff8a3d' [text]='#f4f1ff' [muted]='#8f96b3' [border]='#4b3a78' [select]='#2b2140'
                [match]='#ff4fd8' [pointer]='#ff4fd8' [ok]='#44FFB1' [bad]='#fb858f' [warn]='#f2cc70' [bg]=''
                [orange]='#ff8a3d' [pink]='#ff4fd8' [violet]='#9d6bff' [cyan]='#3ad8ff') ;;
    esac
}
theme_files() { # every NAME.theme found, one name per line
    local d f
    for d in "${THEME_DIRS[@]}"; do for f in "$d"/*.theme; do [[ -f $f ]] && basename "$f" .theme; done; done
}
theme_load() { # theme_load NAME: defaults, then the built-in, then the user's file
    local d k v
    theme_defaults
    theme_builtin "$1"
    for d in "${THEME_DIRS[@]}"; do
        [[ -f $d/$1.theme ]] || continue
        while IFS='=' read -r k v; do
            k=${k//[[:space:]]/}; v=${v#"${v%%[![:space:]]*}"}; v=${v%%[[:space:]]*}
            [[ $k =~ ^[a-z]+$ && ( -z $v || $v =~ ^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$ ) ]] && T[$k]=$v
        done < <(grep -v '^[[:space:]]*#' "$d/$1.theme" | grep '=')
        break
    done
}
theme_names() { printf '%s\n' deep marina midnight full plain; theme_files; }

hex_rgb() { local h=${1#\#}; ((${#h} == 3)) && h=${h:0:1}${h:0:1}${h:1:1}${h:1:1}${h:2:1}${h:2:1}; R_=$((16#${h:0:2})) G_=$((16#${h:2:2})) B_=$((16#${h:4:2})); }
hex_256() { # nearest xterm-256 colour of #rrggbb (the 6x6x6 cube or the grey ramp)
    local r g b gr
    hex_rgb "$1"; r=$(((R_ * 5 + 127) / 255)) g=$(((G_ * 5 + 127) / 255)) b=$(((B_ * 5 + 127) / 255))
    gr=$(((R_ + G_ + B_) / 3))
    if ((R_ - G_ < 10 && G_ - R_ < 10 && G_ - B_ < 10 && B_ - G_ < 10)) && ((gr > 8 && gr < 238)); then echo $((232 + (gr - 8) / 10)); else echo $((16 + 36 * r + 6 * g + b)); fi
}
TRUECOLOR=0
[[ ${COLORTERM:-} == truecolor || ${COLORTERM:-} == 24bit ]] && TRUECOLOR=1
fg_code() { # fg_code #rrggbb: escape sequence for a text colour
    if ((TRUECOLOR)); then hex_rgb "$1"; printf '\033[38;2;%s;%s;%sm' "$R_" "$G_" "$B_"; else printf '\033[38;5;%sm' "$(hex_256 "$1")"; fi
}
fzf_col() { # fzf_col #rrggbb: the colour as fzf wants it
    if ((TRUECOLOR)); then echo "$1"; else hex_256 "$1"; fi
}

THEME=$(conf_get theme); THEME=${THEME:-${NIXDATIFIER_THEME:-deep}}
LAYOUT=$(conf_get layout); LAYOUT=${LAYOUT:-${NIXDATIFIER_LAYOUT:-}}
# Not "theme_names | grep -q": with pipefail, grep leaving early fails the pipe.
theme_known() { local n; while read -r n; do [[ $n == "$1" ]] && return 0; done < <(theme_names); return 1; }
theme_known "$THEME" || THEME=deep
[[ $LAYOUT == compact ]] || LAYOUT=roomy
[[ -z ${NO_COLOR:-} ]] || THEME=plain
cycle_conf() { # cycle_conf theme|layout: step to the next value and remember it
    local next names n prev=''
    if [[ $1 == theme ]]; then
        mapfile -t names < <(theme_names | awk '!s[$0]++')
        next=${names[0]}
        for n in "${names[@]}"; do [[ $prev == "$THEME" ]] && { next=$n; break; }; prev=$n; done
    else
        case $LAYOUT in roomy) next=compact ;; *) next=roomy ;; esac
    fi
    mkdir -p "$(dirname "$CONF")" || return 0
    { grep -v "^$1=" "$CONF" 2>/dev/null; echo "$1=$next"; } >"$CONF.new" && mv "$CONF.new" "$CONF"
}
palette() {
    local e=$'\033'
    O='' P='' V='' C='' G='' R='' Y='' D="${e}[2m" B="${e}[1m" S="${e}[9m" X="${e}[0m" clr=(--color never)
    if [[ $THEME == plain ]]; then P="${e}[1m"; return 0; fi
    theme_load "$THEME"
    clr=(--color always)
    P=$(fg_code "${T[accent]}") G=$(fg_code "${T[ok]}") R=$(fg_code "${T[bad]}") Y=$(fg_code "${T[warn]}")
    O=$P V=$P C=$P
    [[ -z ${T[orange]:-} ]] || { O=$(fg_code "${T[orange]}") V=$(fg_code "${T[violet]:-${T[accent]}}") C=$(fg_code "${T[cyan]:-${T[accent]}}"); P=$(fg_code "${T[pink]:-${T[accent]}}"); }
}
fzf_theme() {
    [[ $THEME != plain ]] || { echo --color=bw; return; }
    theme_load "$THEME"
    local c=() k bg=-1
    for k in accent label text muted border select match pointer ok; do c+=("$(fzf_col "${T[$k]}")"); done
    local accent=${c[0]} label=${c[1]} text=${c[2]} muted=${c[3]} border=${c[4]} select=${c[5]} match=${c[6]} pointer=${c[7]} ok=${c[8]}
    # A background only with truecolor: the nearest 256 colour would look off.
    [[ -n ${T[bg]} ]] && ((TRUECOLOR)) && bg=${T[bg]}
    printf '%s\n' --color "bg:$bg,fg:$text,hl:$match,fg+:$text:bold,bg+:$select,hl+:$match:bold,info:$muted,prompt:$accent,pointer:$pointer,marker:$ok,spinner:$accent,header:$muted,border:$border,label:$label:bold,query:$text:regular,gutter:$bg,scrollbar:$border,separator:$border,preview-border:$border,preview-label:$label:bold,list-label:$label:bold,input-label:$muted,header-label:$muted,footer:$muted,ghost:$border"
}
palette

# Everything every screen shares: full-screen, bordered sections, the theme,
# bash for bindings (not the user's shell), and the keys that work everywhere.
base_opts() {
    local theme
    mapfile -t theme < <(fzf_theme)
    FZF_BASE=("${theme[@]}" --ansi --style "$([[ $LAYOUT == roomy && $(tput lines 2>/dev/null </dev/tty || echo 40) -ge 18 ]] && echo full || echo default)" --layout reverse --cycle --info inline-right --highlight-line
        --pointer '▌' --marker '┃' --gutter ' ' --prompt '❯ ' --scrollbar '▐' --separator '─' --ellipsis '…'
        --with-shell 'bash -c' --delimiter '\t' --preview-window 'right,55%,wrap'
        --bind 'start,resize:transform:$NXD_TUI _fit "$FZF_COLUMNS" "$FZF_LINES"' \
        --bind 'ctrl-/:toggle-preview,alt-p:toggle-preview,alt-up:preview-page-up,alt-down:preview-page-down'
        --bind 'shift-up:preview-up,shift-down:preview-down,f1:preview($NXD_TUI _help)'
        # The mouse: click a key in the footer to press it ("back" goes back), or right-click anywhere to go back.
        --bind 'click-footer:transform:$NXD_TUI _click "$FZF_CLICK_FOOTER_WORD"'
        --bind 'right-click:abort'
        --bind 'alt-x:execute-silent(touch "$NXD_STATE/dismissed")+bg-transform-header($NXD_TUI _header)'
        --bind 'click-header:transform:[[ $FZF_CLICK_HEADER_LINE == 1 && -s $NXD_STATE/updates && ! -e $NXD_STATE/dismissed && $(cat "$NXD_STATE/updates") != 0 ]] && echo "execute-silent(touch \"\$NXD_STATE/dismissed\")+bg-transform-header(\$NXD_TUI _header)"')
}
# One key hint for the footer: the key in pink, what it does dimmed.
key() { printf '%s%s%s %s%s%s' "$P$B" "$1" "$X" "$D" "$2" "$X"; }
# The hints, wrapped onto lines that fit the list pane (about 45% of the
# terminal beside a preview, all of it when the preview is below).
keys() {
    local cols max out='' line='' len=0 k item w
    cols=$(tput cols 2>/dev/null </dev/tty) || cols=${COLUMNS:-100}
    if ((cols >= 70)); then max=$((cols * 45 / 100 - 6)); else max=$((cols - 6)); fi
    ((max >= 24)) || max=24
    for k in "$@"; do
        item=$(key "${k%%=*}" "${k#*=}")
        w=$((${#k} + 1))
        if ((len > 0 && len + 3 + w > max)); then out+="$line"$'\n'; line=$item len=$w
        else line+="${line:+   }$item"; len=$((len + (len ? 3 : 0) + w)); fi
    done
    printf '%s' "$out$line"
}

# The logo as coloured blocks (any terminal) or, with NIXDATIFIER_LOGO=image, as
# a real picture through the terminal's graphics protocol (kitty, sixel, iTerm).
# Nothing without chafa or with NIXDATIFIER_LOGO=off. Rendering scales a large
# PNG, so each size is drawn once per session.
logo() { # logo <columns> <rows>
    local img='' f out mode=${NIXDATIFIER_LOGO:-blocks}
    [[ $mode != off && $LAYOUT == roomy && $THEME != plain ]] && command -v chafa >/dev/null || return 0
    out=${NXD_STATE:-/tmp}/logo-$mode-$1x$2
    # Our own SVG first (sharp at any size); the PNG when chafa has no SVG loader.
    for f in "$here/../../../icon-emblem.svg" "$here/../../../icon-emblem.png" "$here/../../../icon.png"; do
        [[ -f $f ]] || continue
        img=$f; rm -f "$out"
        logo_render "$img" "$1" "$2" "$mode" "$out"
        [[ -s $out ]] && break
    done
    [[ -s $out ]] && cat "$out"
}
logo_render() { # logo_render IMAGE COLUMNS ROWS MODE OUTFILE
    local img=$1 cols=$2 rows=$3 mode=$4 out=$5
    if [[ $mode == image ]]; then chafa --animate off --polite on -s "${cols}x$rows" "$img" >"$out" 2>/dev/null
    else chafa --animate off --polite on -f symbols --symbols half+quad+block+space -c "$([[ ${COLORTERM:-} =~ ^(truecolor|24bit)$ ]] && echo full || echo 256)" -s "${cols}x$rows" "$img" >"$out" 2>/dev/null; fi
}
# The overview's top: the logo with the name and system facts beside it. A
# picture (NIXDATIFIER_LOGO=image) or a narrow preview stacks them instead.
overview_top() { # overview_top <preview columns>
    local side ver w=18 h=8
    ver=$("$NXD_CLI" --version 2>/dev/null)
    side=$(printf '\n%s%s❄  nix%sdati%sfier%s  %s%s%s\n' "$B" "$C" "$V" "$P" "$X" "$D" "${ver#nixdatifier }" "$X"
        printf '%sgenerations · updates · cleanup · dev shells%s\n\n' "$D" "$X"
        cli info)
    if [[ ${NIXDATIFIER_LOGO:-blocks} != blocks ]] || (($1 < 48)) || ! command -v chafa >/dev/null; then
        logo 18 8 2>/dev/null
        printf '%s\n' "$side"
        return
    fi
    awk -v w="$w" 'NR == FNR { l[++n] = $0; next } { s[++m] = $0 }
        END { for (i = 1; i <= (n > m ? n : m); i++) printf "%s   %s\n", (i <= n ? l[i] : sprintf("%" w "s", "")), s[i] }' \
        <(logo "$w" "$h") <(printf '%s\n' "$side")
}

# Colours the CLI's plain text views (version changes, counts, titles).
tint() {
    [[ $THEME != plain ]] || { cat; return; }
    local e=$'\033'
    sed -E \
        -e "s/([0-9][^ ,]*) → ([0-9][^ ,]*)/${e}[31m\1${e}[0m → ${e}[32m\2${e}[0m/g" \
        -e "s/(\\+[0-9]+ added)/${e}[32m\1${e}[0m/; s/(-[0-9]+ removed)/${e}[31m\1${e}[0m/; s/(~[0-9]+ changed)/${e}[33m\1${e}[0m/" \
        -e "s/^(Generation [0-9]+ -> [0-9]+)/${e}[1;36m\1${e}[0m/; s/^(Closure:)/${e}[2m\1${e}[0m/" \
        -e "s/^(Usage:.*)/${e}[1m\1${e}[0m/"
}
cli() { "$NXD_CLI" "${clr[@]}" "$@" 2>&1 | tint; }
hb() { local n=${1:-0}; numfmt --to=iec --suffix=B "${n#-}" 2>/dev/null || printf '%sB' "${n#-}"; }

# ── Shared pieces ───────────────────────────────────────────────────────────
status_line() { # status_line [--updates]; the header every screen starts with
    local json ver n banner=false
    json=$("$NXD_CLI" --json status "$@" 2>/dev/null) || json='{}'
    ver=$("$NXD_CLI" --version 2>/dev/null)
    # Updates found by the check stay in the header as a banner until dismissed
    # (click it or Alt-X), so they are seen when the view opens.
    case " $* " in *" --updates "*) jq -r '.updates // 0' <<<"$json" >"$NXD_STATE/updates" ;; esac
    n=$(cat "$NXD_STATE/updates" 2>/dev/null)
    if ((${n:-0} > 0)) && [[ ! -e $NXD_STATE/dismissed ]]; then
        banner=true # the banner says it; the count below would only repeat it
        printf '  %s%s↑ %s update%s available%s  %s· see Updates · click here or Alt-X to dismiss%s\n' "$B" "$Y" "$n" "$([[ $n -gt 1 ]] && echo s)" "$X" "$D" "$X"
    fi
    jq -r --argjson banner "$banner" --arg ver "${ver#nixdatifier }" --arg O "$O" --arg P "$P" --arg V "$V" --arg C "$C" --arg G "$G" --arg R "$R" \
        --arg Y "$Y" --arg D "$D" --arg B "$B" --arg X "$X" '
        "  \($D)│\($X)  " as $sep
        | ([ "\($B)\($C)❄ nix\($V)dati\($P)fier\($X) \($D)\($ver)\($X)",
             (if .running then "\($O)◆\($X) next boot \($B)\(.running)\($X)" else "not NixOS" end),
             (if .booted then "\($G)⏻\($X) booted \(.booted)" else empty end)
           ] | join($sep)),
          ([ (if .release then "NixOS \(.release)\(if .eol then " \($D)· EOL \(.eol)\($X)" else "" end)" else empty end),
             (if .rebootRequired then "\($Y)⟳ reboot needed\($X)" else empty end),
             (if (.failedUnits // 0) > 0 then "\($R)✗ \(.failedUnits) failed units\($X)" else "\($G)✓\($X) units ok" end),
             (if .updates == null then empty elif .updates > 0 then (if $banner then empty else "\($O)↑ \(.updates) update\(if .updates > 1 then "s" else "" end)\($X)" end) else "\($G)✓\($X) inputs current" end)
           ] | join($sep))' <<<"$json"
}

# The header every screen shows at once: the last one fetched, or a placeholder
# while the real one (slow: it asks nix) is loading in the background.
header_cached() { cat "$NXD_STATE/header" 2>/dev/null || printf '%s❄ nixdatifier%s  %sreading the system…%s' "$B$P" "$X" "$D" "$X"; }

# Output as a scrollable, searchable page in the same look; Esc or Backspace
# goes back. Text comes on stdin.
# Shown while something loads before a screen opens, so the terminal's earlier
# output (the shell that started us) never shows through in the meantime.
working() { clear; printf '\n  %s◌ %s…%s\n' "$D" "$1" "$X"; }
page() { # page <title>
    local file
    file=$NXD_STATE/page.$$
    cat >"$file"
    [[ -s $file ]] || echo "${D}(nothing to show)${X}" >"$file"
    fzf "${FZF_BASE[@]}" --no-sort --exact --wrap --track --list-label " $1 " --input-label ' Search ' \
        --ghost 'type to search this page' --footer "$(keys 'Esc/⌫=back' '↑↓ PgUp PgDn=scroll' 'type=search')" \
        --bind 'enter:ignore,backward-eof:abort' <"$file" >/dev/null
    rm -f "$file"
}
# Run a CLI action with the terminal (it asks before changing anything), then
# wait for a key so the result can be read.
act() {
    local rc
    clear
    printf '%s%s❯ nixdatifier %s%s\n\n' "$B" "$C" "$*" "$X"
    "$NXD_CLI" "${clr[@]}" "$@"
    rc=$?
    if ((rc == 0)); then printf '\n%s✓ done%s' "$G$B" "$X"
    elif ((rc == 75)); then printf '\n%s… another change is running; try again when it finishes%s' "$Y" "$X"
    else printf '\n%s✗ stopped (exit %s)%s' "$R$B" "$rc" "$X"; fi
    printf '   %spress any key to go back%s' "$D" "$X"
    read -rsn1 _ </dev/tty
    return 0
}
ask() { # ask <prompt>; one line from the user, empty when cancelled
    local reply
    printf '\n %s❯%s %s ' "$P$B" "$X" "$1" >/dev/tty
    read -r reply </dev/tty || return 1
    printf '%s' "$reply"
}

# ── Package changes ─────────────────────────────────────────────────────────
# One row per change, "kind<TAB>name<TAB>old<TAB>new<TAB>display". The CLI prints changes as
# "name: old → new, size"; ∅ marks a missing side, ε a missing version.
change_rows() { # JSON from `diff --json` on stdin
    jq -r '.changes[]' | LC_ALL=C awk -v g="$G" -v r="$R" -v y="$Y" -v d="$D" -v b="$B" -v s="$S" -v x="$X" '
        {
            i = index($0, ": "); name = substr($0, 1, i - 1); rest = substr($0, i + 2)
            old = ""; new = ""; size = ""
            j = index(rest, " → ")
            if (j) {
                old = substr(rest, 1, j - 1); rest = substr(rest, j + 5)
                k = index(rest, ", "); if (k) { new = substr(rest, 1, k - 1); size = substr(rest, k + 2) } else new = rest
            } else size = rest
            kind = "C"; if (old == "∅") kind = "A"; else if (new == "∅") kind = "R"
            vo = (kind == "A") ? "" : old; vn = (kind == "R") ? "" : new
            if (old == "ε") old = ""; if (new == "ε") new = ""
            shown = name; if (length(shown) > 30) shown = substr(shown, 1, 29) "~"
            if (kind == "A") { sym = g b "+" x; ver = sprintf("%12s   %s%-14s%s", "", g, new, x); nm = b shown x }
            else if (kind == "R") { sym = r b "-" x; ver = sprintf("%s%12s%s   %-14s", d s, old, x, ""); nm = d s shown x }
            else {
                sym = y b "~" x; nm = shown
                ver = (old == "" && new == "") ? sprintf("%12s   %s%-14s%s", "", d, "size only", x) : sprintf("%s%12s%s → %s%-14s%s", r, old, x, g, new, x)
            }
            printf "%s\t%s\t%s\t%s\t%s %s%*s %s %s%10s%s\t%s\n", kind, name, vo, vn, sym, nm, 31 - length(shown), "", ver, y, size, x, size
        }'
}
change_summary() { # change_summary <json> <label>
    jq -r --arg label "$2" --arg C "$C" --arg G "$G" --arg R "$R" --arg Y "$Y" --arg D "$D" --arg B "$B" --arg X "$X" '
        "\($B)\($C)Generation \(.base) → \(.target)\($X)  \($D)\($label)\($X)",
        (.kernel | gsub("\\s"; "") | ([scan("-([0-9]+\\.[0-9][0-9.]*)/")] | last | .[0]? // .)) as $k
        | "\($D)NixOS \(.nixosVersion | gsub("\\s"; ""))\(if $k != "" then "  ·  linux \($k)" else "" end)\($X)",
        "\($G)+\(.counts.added // 0) added\($X)  \($R)-\(.counts.removed // 0) removed\($X)  \($Y)~\(.counts.changed // 0) changed\($X)"' <<<"$1"
    jq -r '[.closureBytes // 0, .counts.addedBytes // 0, .counts.removedBytes // 0] | @tsv' <<<"$1" | {
        read -r total added removed
        printf '%sclosure %s  ·  ▲ %s new  ▼ %s gone%s\n' "$D" "$(hb "$total")" "$(hb "$added")" "$(hb "$removed")" "$X"
    }
}
# A generation never changes, so the diff of two is kept on disk, keyed by both
# numbers and store paths (a number can be reused after deleting). Comparing
# closures takes seconds; opening a pair seen before is then instant.
diff_json() { # diff_json [BASE TARGET]; no arguments: newest vs previous
    local a=${1:-} b=${2:-} key f
    [[ -n $b ]] || b=$(gens_json | jq -r '.[0].number // empty')
    [[ -n $a ]] || a=$(gen_base "$b" prev)
    [[ -n $a && -n $b ]] || return 1
    key=$(gens_json | jq -r --argjson a "$a" --argjson b "$b" '
        (map({key: (.number | tostring), value: (.storePath | ltrimstr("/nix/store/") | .[:12])}) | from_entries) as $p
        | "\($a)-\($b)-\($p[$a | tostring] // "x")\($p[$b | tostring] // "x")"')
    f=$NXD_CACHE/diff-$key.json
    if [[ ! -s $f ]]; then
        "$NXD_CLI" --json diff "$a" "$b" >"$f.$$" 2>/dev/null && jq -e .changes "$f.$$" >/dev/null 2>&1 || { rm -f "$f.$$"; return 1; }
        mv -f "$f.$$" "$f"
    fi
    cat "$f"
}

# The compare base for a generation: previous, booted, or next boot (the
# system profile), like the window's "vs. previous / vs. booted" toggle.
gens_json() { # gens_json [fresh]
    local f=$NXD_STATE/gens.json
    [[ -s $f && ${1:-} != fresh ]] || "$NXD_CLI" --json generations >"$f" 2>/dev/null || echo '[]' >"$f"
    cat "$f"
}
compare_mode() { cat "$NXD_STATE/mode" 2>/dev/null || echo prev; }
mode_label() { case $1 in prev) echo 'vs previous' ;; booted) echo 'vs booted' ;; next) echo 'vs next boot' ;; esac; }
gen_base() { # gen_base N MODE; prints the base number or nothing
    gens_json | jq -r --argjson n "$1" --arg m "$2" '
        if $m == "prev" then (map(select(.number < $n)) | max_by(.number) | .number // empty)
        elif $m == "booted" then (map(select(.booted)) | .[0].number // empty)
        else (map(select(.active)) | .[0].number // empty) end'
}
gen_diff_preview() { # gen_diff_preview N [MODE]
    local n=$1 mode=${2:-$(compare_mode)} a json
    a=$(gen_base "$n" "$mode")
    if [[ -z $a ]]; then printf '%s#%s has no earlier generation.%s\n' "$D" "$n" "$X"; return; fi
    if [[ $a == "$n" ]]; then
        printf '%s#%s is the %s generation itself.%s\n\n%s\n' "$B" "$n" "${mode/next/next-boot}" "$X" "$(key Ctrl-O 'compare with something else')"
        return
    fi
    json=$(diff_json "$a" "$n") || { echo "${R}diff failed${X}"; return; }
    change_summary "$json" "$(mode_label "$mode")"
    echo
    change_rows <<<"$json" | cut -f5 | grep . || printf '%sNo package changes.%s\n' "$D" "$X"
}

# The full list for two generations: filter buttons in the header (clickable,
# or Tab to cycle, Alt-A/R/C/0), search by typing, Enter shows the store paths.
#
# It opens at once and fills in when the closures are compared (seconds the
# first time, instant after), so keys typed meanwhile go to fzf.
changes_screen() { # changes_screen [BASE TARGET] [label]; no pair: newest vs previous
    local a=${1:-} b=${2:-} label=${3:-}
    [[ -n $b ]] || b=$(gens_json | jq -r '.[0].number // empty')
    [[ -n $a ]] || a=$(gen_base "$b" prev)
    [[ -n $a && -n $b ]] || { echo "${D}Nothing to compare: there is only one generation.${X}" | page 'What changed'; return; }
    export NXD_CHANGES=$NXD_STATE/changes.$$ NXD_A=$a NXD_B=$b NXD_LABEL=$label
    echo all >"$NXD_STATE/filter"
    : >"$NXD_CHANGES"
    fzf "${FZF_BASE[@]}" --with-nth 5 --no-sort --exact --list-label " #$a → #$b ${label:+· $label }" --input-label ' Filter packages ' \
        --ghost 'type a package name' --preview-label ' Package ' \
        --header "${D}Comparing #$a and #$b…${X}" --header-label ' Changes ' \
        --footer "$(keys 'Tab=next filter' 'click/Alt-A R C 0=filter' 'Enter=store paths' 'Esc/⌫=back')" \
        --preview '$NXD_TUI _paths {2} {3} {4} {6}' \
        --bind 'start:reload($NXD_TUI _changerows)' \
        --bind 'load:transform-header($NXD_TUI _changehead)' \
        --bind 'tab:transform($NXD_TUI _filter next)' \
        --bind 'alt-0:transform($NXD_TUI _filter all),alt-a:transform($NXD_TUI _filter A),alt-r:transform($NXD_TUI _filter R),alt-c:transform($NXD_TUI _filter C)' \
        --bind 'click-header:transform:case $FZF_CLICK_HEADER_WORD in *All*) $NXD_TUI _filter all ;; *Added*) $NXD_TUI _filter A ;; *Removed*) $NXD_TUI _filter R ;; *Changed*) $NXD_TUI _filter C ;; esac' \
        --bind 'enter:toggle-preview,backward-eof:abort' </dev/null >/dev/null
    rm -f "$NXD_CHANGES"
}
changes_load() { # the rows of $NXD_A → $NXD_B, kept in $NXD_CHANGES for the filters
    local json
    json=$(diff_json "$NXD_A" "$NXD_B") || return 0
    change_rows <<<"$json" | tee "$NXD_CHANGES"
}
changes_header() { # summary and the filter buttons with their counts
    local json add rem chg
    json=$(diff_json "$NXD_A" "$NXD_B") || { echo "${R}Could not compare #$NXD_A and #$NXD_B.${X}"; return; }
    change_summary "$json" "$NXD_LABEL" | sed -n '2,4p'
    add=$(grep -c '^A' "$NXD_CHANGES"); rem=$(grep -c '^R' "$NXD_CHANGES"); chg=$(grep -c '^C' "$NXD_CHANGES")
    if ((add + rem + chg == 0)); then printf '%sNo package changes between these generations.%s\n' "$D" "$X"; return; fi
    printf '%s[All %s]%s  %s[+Added %s]%s  %s[-Removed %s]%s  %s[~Changed %s]%s\n' \
        "$B" $((add + rem + chg)) "$X" "$G" "$add" "$X" "$R" "$rem" "$X" "$Y" "$chg" "$X"
}
filter_action() { # filter_action all|A|R|C|next; prints the fzf actions
    local f=$1 cur
    cur=$(cat "$NXD_STATE/filter" 2>/dev/null || echo all)
    if [[ $f == next ]]; then case $cur in all) f=A ;; A) f=R ;; R) f=C ;; *) f=all ;; esac; fi
    echo "$f" >"$NXD_STATE/filter"
    local name
    case $f in all) name='All' ;; A) name='Added' ;; R) name='Removed' ;; C) name='Changed' ;; esac
    if [[ $f == all ]]; then printf 'reload(cat %q)' "$NXD_CHANGES"; else printf 'reload(grep -a %q %q || true)' "^$f" "$NXD_CHANGES"; fi
    printf '+change-input-label( Filter packages · %s )+first' "$name"
}
store_paths() { # store_paths NAME OLD NEW SIZE; a card like the widget's: version, size, paths, link
    local n v e=$'\033' url
    url="https://github.com/NixOS/nixpkgs/search?q=$1"
    printf '%s%s%s\n\n' "$B" "$1" "$X"
    printf '%sVersion%s     %s%s%s → %s%s%s\n' "$D" "$X" "$R" "${2:-none}" "$X" "$G" "${3:-none}" "$X"
    printf '%sSize delta%s  %s%s%s\n\n' "$D" "$X" "$Y" "${4:-?}" "$X"
    for n in "$NXD_B" "$NXD_A"; do
        v=$3; [[ $n == "$NXD_B" ]] || v=$2
        printf '%sStore path in #%s%s\n' "$D" "$n" "$X"
        if [[ -n $v ]]; then "$NXD_CLI" path "$1" "$v" --generation "$n" 2>/dev/null | sed 's/^/  /' | grep .; else false; fi ||
            printf '  %snot in this generation%s\n' "$D" "$X"
        echo
    done
    printf '%snixpkgs%s      %s%s' "$D" "$X" "$e]8;;$url$e\\" "$P$url$X$e]8;;$e\\"
    echo
}

# ── Screens ─────────────────────────────────────────────────────────────────
gen_rows() {
    gens_json fresh | jq -r --arg O "$O" --arg P "$P" --arg C "$C" --arg G "$G" --arg D "$D" --arg B "$B" --arg X "$X" '.[] |
        (.nixosVersion // "" | split(".")) as $v
        | "\(.number)\t\($P)\($B)#\(.number)\($X)  \(.date[:16])  \($v[0:2] | join("."))\($D)\(if ($v | length) > 3 then " · \($v[3])" else "" end)\($X)  \($C)\(.kernel // "")\($X)\(if .active then "  \($O)◆ next boot\($X)" else "" end)\(if .booted then "  \($G)⏻ booted\($X)" else "" end)"'
}
# Pick any two generations and see what changed between them: Tab marks one,
# Enter on a second compares the two (or with two marked).
compare_screen() {
    fzf "${FZF_BASE[@]}" --multi 2 --with-nth 2 --no-sort --list-label ' Compare two generations ' --input-label ' Search ' \
        --ghost 'number, date or version' --header "$(header_cached)" --header-label ' System ' \
        --footer "$(keys 'Enter=mark the first, then Enter on the second to compare' 'Tab=mark too' 'Esc/⌫=back')" \
        --preview '$NXD_TUI _gendiff {1}' --preview-label ' Against its previous ' \
        --bind 'start:reload($NXD_TUI _gens)' \
        --bind 'enter:transform:if ((FZF_SELECT_COUNT == 0)); then echo "select+change-prompt(#"{1}" marked, now Enter on the second ❯ )"; else echo "execute(\$NXD_TUI _compare {1} {+1})+clear-selection+change-prompt(❯ )"; fi' \
        --bind 'backward-eof:abort' </dev/null >/dev/null
}
compare_open() { # compare_open CURRENT [MARKED...]
    local a b
    if (($# >= 3)); then read -r a b < <(printf '%s\n' "${@:2}" | sort -n | head -2 | paste -sd' ')
    elif (($# == 2)) && [[ $1 != "$2" ]]; then read -r a b < <(printf '%s\n%s\n' "$1" "$2" | sort -n | paste -sd' ')
    else
        return 0
    fi
    changes_screen "$a" "$b" 'compared'
}
generations_screen() {
    [[ -f $NXD_STATE/mode ]] || echo prev >"$NXD_STATE/mode"
    fzf "${FZF_BASE[@]}" --multi --with-nth 2 --no-sort --list-label ' Generations ' --input-label ' Search ' \
        --ghost 'number, date or version' --header "$(header_cached)" --header-label ' System ' \
        --footer "$(keys 'Enter=what changed' 'Tab=mark two to compare' "Ctrl-O=compare base" 'Ctrl-S=switch' 'Ctrl-B=boot' 'Ctrl-D=delete' 'Esc/⌫=back')" \
        --preview '$NXD_TUI _gendiff {1}' \
        --bind 'start:reload($NXD_TUI _gens)' \
        --bind 'focus:transform-preview-label[echo " #"{1}" · $($NXD_TUI _modelabel) "]' \
        --bind 'ctrl-o:execute-silent($NXD_TUI _cyclemode)+refresh-preview+transform-preview-label[echo " #"{1}" · $($NXD_TUI _modelabel) "]' \
        --bind 'enter:execute($NXD_TUI _opengen {1} {+1})+clear-selection' \
        --bind 'ctrl-s:execute($NXD_TUI _act switch {1})+reload($NXD_TUI _gens)+transform-header($NXD_TUI _header)' \
        --bind 'ctrl-b:execute($NXD_TUI _act boot {1})+reload($NXD_TUI _gens)+transform-header($NXD_TUI _header)' \
        --bind 'ctrl-d:execute($NXD_TUI _act delete {+1})+clear-selection+reload($NXD_TUI _gens)' \
        --bind 'ctrl-r:reload($NXD_TUI _gens)+transform-header($NXD_TUI _header)' \
        --bind 'backward-eof:abort' </dev/null >/dev/null
}
open_generation() { # open_generation CURRENT [MARKED...]; two marks compare each other
    local a b
    if (($# >= 3)); then
        read -r a b < <(printf '%s\n' "${@:2}" | sort -n | head -2 | paste -sd' ')
        changes_screen "$a" "$b" 'marked'
        return
    fi
    a=$(gen_base "$1" "$(compare_mode)")
    if [[ -z $a || $a == "$1" ]]; then gen_diff_preview "$1" | page "#$1"; return; fi
    changes_screen "$a" "$1" "$(mode_label "$(compare_mode)")"
}

input_rows() { # input_rows [--refresh]: only the inputs with an update, like the window; Alt-A lists all
    local all=0
    [[ -e $NXD_STATE/showall ]] && all=1
    "$NXD_CLI" --json updates --all "$@" 2>/dev/null | jq -r --argjson all "$all" --arg O "$O" --arg G "$G" --arg R "$R" --arg D "$D" --arg B "$B" --arg X "$X" '
        def row:
            def strike: "\u001b[9m";
            (if .status == "update" then "\($O)↑" elif .status == "unchanged" then "\($G)✓" elif .status == "unreachable" then "\($R)✗" else "\($D)·" end) as $icon
            | if .status == "ignored" then "\(.input)\t\(.status)\t\($D)· \(strike)\(.input)\($X)\($D)\(" " * ([28 - (.input | length), 1] | max))not checked\($X)"
              else "\(.input)\t\(.status)\t\($icon)\($X) \($B)\(.input)\($X)\(" " * ([28 - (.input | length), 1] | max))\($D)\(.status)\(" " * ([12 - (.status | length), 1] | max))\($X)\(if .status == "update" then "\(.from) → \($O)\(.to)\($X)" else "\($D)\(.from)\($X)" end)  \($D)\(.date)\($X)" end;
        (map(select(.status == "update")) | sort_by(.input)) as $up
        | (map(select(.status == "unreachable")) | length) as $bad
        | (map(select(.status == "ignored")) | length) as $skip
        | if $all == 1 then (sort_by(if .status == "update" then 0 elif .status == "unreachable" then 1 else 2 end, .input)[] | row)
          else
            ($up[] | row),
            (if $bad > 0 then "@unreachable\tinfo\t\($R)✗\($X) \($B)\($bad) input\(if $bad > 1 then "s" else "" end) could not be checked\($X)  \($D)offline? Alt-A lists them\($X)" else empty end),
            (if $skip > 0 then "@ignored\tinfo\t\($D)·\($X) \($B)\($skip) input\(if $skip > 1 then "s" else "" end) not checked\($X)  \($D)on your input list, Alt-A lists them\($X)" else empty end),
            (if ($up | length) == 0 and $bad == 0 then "@current\tinfo\t\($G)✓\($X) \($B)Every input is up to date\($X)" else empty end)
          end'
}
input_preview() { # input_preview NAME STATUS
    if [[ $2 == update ]]; then
        printf '%s%s%s has an update.%s\n\n%sWhat is new%s\n' "$B" "$O" "$1" "$X" "$B" "$X"
        cli notes "$1"
        printf '\n%sPackage changes%s %s(what a rebuild would change)%s\n' "$B" "$X" "$D" "$X"
        cli preview "$1" | head -60
    elif [[ $2 == info ]]; then
        case $1 in
            @unreachable) printf 'Some inputs could not be reached, usually because the network is down.\n\nAlt-A shows every input with the reason. Ctrl-R checks again.\n' ;;
            @ignored) printf 'Some inputs are on your input list, so they are not checked for updates.\n\nAlt-A shows them. Edit the list with: nixdatifier config set ignored_inputs ...\n' ;;
            *) printf 'Nothing to update.\n\nAlt-A shows every input anyway.\n' ;;
        esac
    else
        "$NXD_CLI" --json updates --all 2>/dev/null | jq -r --arg i "$1" --arg D "$D" --arg X "$X" '.[] | select(.input == $i) |
            "\(.input): \(.status)", "\($D)locked\($X)  \(.current)", "\($D)latest\($X)  \(.latest)", "\($D)date\($X)    \(.date)",
            "\($D)source\($X)  \(.url)", (if .reason != "" then "\($D)reason\($X)  \(.reason)" else empty end)'
    fi
}
