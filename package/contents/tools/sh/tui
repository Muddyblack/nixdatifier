# ── Home ────────────────────────────────────────────────────────────────────
# key, icon, colour, title, description, what Enter does (the preview label)
home_rows() {
    item() { printf '%s\t%s%s%s  %s%-18s%s %s%s%s\t%s\n' "$1" "$3" "$2" "$X" "$B" "$4" "$X" "$D" "$5" "$X" "$6"; }
    item overview '❄' "$C" Overview 'the system at a glance' 'Enter: full screen'
    item generations '◆' "$P" Generations 'browse, compare, switch, delete' 'Enter: open the generations'
    item diff '±' "$P" 'What changed' 'newest generation vs previous' 'Enter: all package changes'
    item compare '⇄' "$P" Compare 'pick any two generations' 'Enter: choose two to compare'
    item updates '↑' "$O" Updates 'flake inputs behind upstream' 'Enter: inputs, notes, update'
    item health '✚' "$G" Health 'release, reboot, units, caches' 'Enter: full screen'
    item disk '▤' "$C" 'Disk & clean up' 'store size, old generations, garbage' 'Enter: details or clean up'
    item history '⟲' "$V" History 'what earlier changes did' 'Enter: every run with output'
    item dev 'λ' "$V" 'Dev environments' 'direnv projects and their cache' 'Enter: projects'
    item persist '◐' "$C" Impermanence 'what survives a reboot' 'Enter: status, sizes, scan, cleanup'
    item secrets '◇' "$O" Secrets 'sops/agenix names, never values' 'Enter: full screen'
    item profiles '⊞' "$P" Profiles 'your packages, Home Manager and nix profile' 'Enter: install, upgrade, remove'
    item info 'i' "$C" 'System info' 'host, version, uptime' 'Enter: full screen'
    item hash '#' "$O" 'Hash calculator' 'fixed-output hash and SRI' 'Enter: paste what to hash'
    item about '♥' "$P" 'About & support' 'the project, links, how to support it' 'Enter: full screen'
