hash_flow() { # one prompt: the kind is judged from what you give
    local what
    clear
    printf '%sHash%s  %sa URL, a local file, a /nix/store path, or owner/repo/rev (github)%s\n\n' "$B" "$X" "$D" "$X"
    what=$(ask "hash of:") || return 0
    [[ -n $what ]] || return 0
    working 'Hashing'
    cli hash "$what" | page "Hash · $what"
}

# ── About and support ───────────────────────────────────────────────────────
# The same facts the widget's info pane shows. The links come from the widget's
# own ProjectInfo.js and ProjectFunding.js, so there is one place to edit them,
# and the brand icons are its SVGs (drawn with chafa when it is there).
CODE_DIR=$here/../../code
ICON_DIR=$here/../../icons
info_var() { sed -n "s/^var $1 = \"\(.*\)\";/\1/p" "$CODE_DIR/ProjectInfo.js" 2>/dev/null | head -1; }
funding_rows() { # label<TAB>url<TAB>icon per funding link
    awk -F'"' '/"label"/ { l = $4 } /"url"/ { u = $4 } /"icon"/ { printf "%s\t%s\t%s\n", l, u, $4 }' "$CODE_DIR/ProjectFunding.js" 2>/dev/null
}
link() { printf '\033]8;;%s\033\\%s%s%s\033]8;;\033\\' "$1" "$P" "${2:-$1}" "$X"; } # clickable where the terminal can
svg_block() { # svg_block FILE COLS ROWS: the icon as blocks, empty without chafa
    [[ $LAYOUT == roomy && $THEME != plain ]] && command -v chafa >/dev/null && [[ -f $1 ]] || return 0
    chafa --animate off --polite on -f symbols --symbols half+quad+block+space -c "$( ((TRUECOLOR)) && echo full || echo 256)" -s "$2x$3" "$1" 2>/dev/null
}
beside() { # beside WIDTH <left file> <right file>: two blocks side by side
    awk -v w="$1" 'NR == FNR { l[++n] = $0; next } { s[++m] = $0 }
        END { for (i = 1; i <= (n > m ? n : m); i++) printf "%s   %s\n", (i <= n ? l[i] : sprintf("%" w "s", "")), s[i] }' "$2" "$3"
}
about_stats() { # about_stats [fetch|-] [release|counts]: stars, downloads and the latest release, cached for an hour
    local f=$NXD_CACHE/about-stats.json repo ver
    repo=$(info_var repository); repo=${repo#https://github.com/}
    if [[ ${1:-} == fetch ]] && [[ ! -s $f || -n $(find "$f" -mmin +60 2>/dev/null) ]]; then
        command -v curl >/dev/null || return 0
        {
            printf '{"stars":%s,"downloads":%s,"latest":%s}\n' \
                "$(curl -fsm 4 "https://img.shields.io/github/stars/$repo.json" | jq '.value // null' 2>/dev/null || echo null)" \
                "$(curl -fsm 4 "https://img.shields.io/github/downloads/$repo/total.json" | jq '.value // null' 2>/dev/null || echo null)" \
                "$(curl -fsm 4 "https://api.github.com/repos/$repo/releases/latest" | jq '.tag_name // null' 2>/dev/null || echo null)"
        } >"$f.new" 2>/dev/null && mv "$f.new" "$f"
    fi
    [[ -s $f ]] || return 0
    ver=$("$NXD_CLI" --version 2>/dev/null); ver=${ver#nixdatifier }
    jq -r --arg v "$ver" --arg sel "${2:-release}" --arg D "$D" --arg G "$G" --arg Y "$Y" --arg X "$X" '
        if $sel == "counts" then
            ([(if .stars then "\($Y)★ \(.stars)\($X) stars" else empty end),
              (if .downloads then "\(.downloads) downloads on GitHub" else empty end)] | join("  \($D)·\($X)  "))
        else
        (if .latest then (.latest | ltrimstr("v")) as $l
            | if $l == $v then "\($G)✓ up to date\($X) \($D)(\($l))\($X)" else "latest release \($l) \($D)· you run \($v)\($X)" end else empty end) end' "$f" 2>/dev/null
}
about_card() { # about_card [full]: the project, its links and how to support it
    local repo author licence store profile ver tmp1 tmp2 label url icon col
    repo=$(info_var repository); author=$(info_var author); licence=$(info_var license)
    store=$(info_var store); profile=$(info_var profile)
    ver=$("$NXD_CLI" --version 2>/dev/null); ver=${ver#nixdatifier }
    tmp1=$NXD_STATE/about.l.$$ tmp2=$NXD_STATE/about.r.$$
    svg_block "$here/../../../icon-emblem.svg" 16 7 >"$tmp1"
    {
        printf '%s%s❄  nixdatifier%s  %s%s%s\n' "$B" "$P" "$X" "$D" "$ver" "$X"
        printf '%sNixOS generations, package diffs, updates and dev shells%s\n\n' "$D" "$X"
        printf '%sby%s %s\n' "$D" "$X" "$(link "$profile" "$author")"
        printf '%s%s%s\n' "$D" "$licence" "$X"
        about_stats "${1:--}" release
    } >"$tmp2"
    if [[ -s $tmp1 ]]; then beside 16 "$tmp1" "$tmp2"; else cat "$tmp2"; fi
    printf '\n%s%sLinks%s\n' "$B" "$P" "$X"
    printf '  %-16s %s\n' 'Repository' "$(link "$repo")" 'Releases' "$(link "$repo/releases")" 'Issues' "$(link "$repo/issues")"
    [[ -z $store ]] || printf '  %-16s %s\n' 'OpenDesktop' "$(link "$store")"
    printf '\n%s%sSupport the project%s\n%sIt is free and stays free. If it saves you time, these keep it going:%s\n\n' "$B" "$P" "$X" "$D" "$X"
    while IFS=$'\t' read -r label url icon; do
        svg_block "$ICON_DIR/$icon" 6 3 >"$tmp1"
        printf '%s%s%s\n%s\n' "$B" "$label" "$X" "$(link "$url")" >"$tmp2"
        if [[ -s $tmp1 ]]; then beside 6 "$tmp1" "$tmp2"; else cat "$tmp2"; fi
        echo
    done < <(funding_rows)
    # The star: the widget's own star icon, the link, and the counts when known
    # star.svg is an outline, which turns to mush at a few cells: fill it in the
    # theme's warning colour (same path, just solid) before drawing it.
    col=${T[warn]:-#f2cc70}
    sed -e "s/fill=\"none\"/fill=\"$col\"/" -e "s/stroke=\"#[0-9a-fA-F]*\"/stroke=\"$col\"/" -e 's/stroke-width="[0-9.]*"/stroke-width="2.4"/' \
        "$ICON_DIR/star.svg" >"$NXD_STATE/star.svg" 2>/dev/null
    svg_block "$NXD_STATE/star.svg" 8 4 >"$tmp1"
    {
        printf '%s%sStar it on GitHub%s\n%s\n' "$([[ -s $tmp1 ]] || printf '%s★ ' "$Y")" "$B$Y" "$X" "$(link "$repo/stargazers")"
        printf '%sA star is the cheapest way to say thanks and helps others find it.%s\n' "$D" "$X"
        about_stats "${1:--}" counts
    } >"$tmp2"
    if [[ -s $tmp1 ]]; then beside 6 "$tmp1" "$tmp2"; else cat "$tmp2"; fi
    rm -f "$tmp1" "$tmp2" "$NXD_STATE/star.svg"
}

# ── Settings ────────────────────────────────────────────────────────────────
# What the widget's General tab asks for, for the command line: saved with
# `nixdatifier config`, read by every command. The look (theme, layout) is the
# view's own and changes with Enter right here.
settings_desc() { # settings_desc KEY: what it is
    case $1 in
        flake) echo 'System flake directory. Empty: found in /etc/nixos, ~/nixos-config or ~/.config/nixos.' ;;
        config_repo) echo 'Git repository that records each generation (which revision built it). Empty: the flake directory.' ;;
        secrets) echo 'Directory of decrypted sops/agenix secrets whose names are listed. Empty: /run/secrets or /run/agenix.d.' ;;
        secrets_source) echo 'The secrets file in the flake (secrets.yaml and the like), used to check freshness. Empty: searched in the flake.' ;;
        persist) echo 'Impermanence roots, separated by colons (for example /persist:/data). Empty: found from the mounts.' ;;
        priv) echo 'Command that gets root for switching and cleaning: sudo, doas or pkexec. Empty: sudo.' ;;
        check_interval) echo 'How often update checks run, here and in the window: 30m, 6h, 1d. Empty: 6h here, 1h in the window. Background checks pick it up when switched on again.' ;;
        notifications) echo 'on or off: desktop notifications when update checks find something, here and in the window. Empty: on.' ;;
        github_token_file) echo 'File holding a GitHub token (a sops/agenix secret path, say) that lifts the rate limit for release notes. Only the path is saved, never the token. Empty: anonymous.' ;;
        github_use_gh) echo 'on: borrow the GitHub CLI login (gh auth token) for release notes when no token file is set. Its token often has wide scopes, so it is off unless you switch it on. Empty: off.' ;;
        check_tarballs) echo 'off: skip tarball flake inputs (channels, .tar.zst) when checking for updates, here and in the window. Empty: on.' ;;
        deep_inputs) echo 'on: check every transitive flake input, not just the root (and wrapper) inputs. Costs one request per input. Empty: off.' ;;
        ignored_inputs) echo 'Flake inputs to skip when checking for updates: names separated by commas, globs allowed (nur, my-private/*). Empty: check them all.' ;;
        theme) echo 'Colour theme: deep, marina, midnight, full, plain or your own (see docs/cli.md). Enter cycles.' ;;
        layout) echo 'roomy: boxed sections with the logo. compact: no boxes. Enter switches.' ;;
    esac
}
settings_rows() { # key<TAB>display
    local k v src n
    n=$("$NXD_CLI" --json commands 2>/dev/null | jq length 2>/dev/null)
    printf '@commands\t%s%-16s%s %s%s saved, shared with the window%s\n' "$B" Commands "$X" "$P" "${n:-0}" "$X"
    printf '@checks\t%s%-16s%s %s%s%s\n' "$B" 'Update checks' "$X" "$P" "$("$NXD_CLI" watch status 2>/dev/null)" "$X"
    while IFS='|' read -r k v src; do
        printf '%s\t%s%-16s%s %s%s%s %s%s%s\n' "$k" "$B" "$k" "$X" "${v:+$P}" "${v:-}" "${v:+$X}" "$D" "$([[ -n $v ]] && echo "($src)" || echo unset)" "$X"
    done < <("$NXD_CLI" --json config 2>/dev/null | jq -r '.[] | select(.key != "commands") | [.key, .value, .source] | join("|")')
    printf '%s\t%s%-16s%s %s%s%s\n' theme "$B" theme "$X" "$P" "$THEME" "$X"
    printf '%s\t%s%-16s%s %s%s%s\n' layout "$B" layout "$X" "$P" "$LAYOUT" "$X"
}
settings_preview() { # settings_preview KEY
    local line
    case $1 in
        @commands) cmd_rows | cut -f2-; printf '\n%sEnter: run, add or remove them (Rebuild is the first row). The window shows the same ones.%s\n' "$D" "$X"; return ;;
        @checks) watch_rows | cut -f2-; printf '\n%sEnter: switch background checks on or off, set how often.%s\n' "$D" "$X"; return ;;
    esac
    printf '%s%s%s\n\n%s\n' "$B" "$1" "$X" "$(settings_desc "$1")"
    case $1 in
        theme | layout) printf '\n%sSaved in %s%s\n' "$D" "$CONF" "$X" ;;
        *)
            line=$("$NXD_CLI" --json config 2>/dev/null | jq -r --arg k "$1" '.[] | select(.key == $k) | .source')
            [[ $line == environment ]] && printf '\n%sSet by an environment variable now; it wins over what is saved.%s\n' "$Y" "$X"
            printf '\n%sSaved in %s%s\n' "$D" "$("$NXD_CLI" config path 2>/dev/null)" "$X" ;;
    esac
}
settings_edit() { # settings_edit KEY: change one setting
    local cur new
    case $1 in
        @commands) commands_screen; return 0 ;;
        @checks) watch_screen; return 0 ;;
        theme | layout) cycle_conf "$1"; return 0 ;;
    esac
    clear
    cur=$("$NXD_CLI" config get "$1" 2>/dev/null)
    printf '%s%s%s\n%s%s%s\n\n' "$B" "$1" "$X" "$D" "$(settings_desc "$1")" "$X"
    read -e -r -i "$cur" -p "  ❯ " new </dev/tty || return 0
    [[ $new == "$cur" ]] || "$NXD_CLI" config set "$1" "$new" 2>&1
}
settings_screen() {
    fzf "${FZF_BASE[@]}" --with-nth 2 --no-sort --list-label ' Settings ' --input-label ' Search ' --ghost 'setting' \
        --header "$(header_cached)" --header-label ' System ' \
        --footer "$(keys 'Enter=change' 'Ctrl-X=clear' 'Esc/⌫=back')" \
        --preview '$NXD_TUI _setpv {1}' --preview-label ' About this setting ' \
        --bind 'start:reload($NXD_TUI _setrows)' \
