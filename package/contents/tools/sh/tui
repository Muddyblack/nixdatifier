# ── Update checks ───────────────────────────────────────────────────────────
# A systemd user timer runs `nixdatifier watch run`, which notifies when there
# are updates it has not told you about yet. Off unless you turn it on.
watch_rows() {
    local json on iv
    json=$("$NXD_CLI" --json watch status 2>/dev/null)
    on=$(jq -r '.enabled' <<<"$json"); iv=$(jq -r '.interval' <<<"$json")
    if [[ $on == true ]]; then printf 'toggle\t%sBackground checks%s  %s● on%s\n' "$B" "$X" "$G" "$X"
    else printf 'toggle\t%sBackground checks%s  %s○ off%s\n' "$B" "$X" "$D" "$X"; fi
    printf 'interval\t%sCheck every%s       %s%s%s\n' "$B" "$X" "$P" "$iv" "$X"
    printf 'now\t%sCheck now%s         %sone check, notify if new%s\n' "$B" "$X" "$D" "$X"
}
watch_preview() {
    case $1 in
        toggle) printf '%sBackground update checks%s\n\nA timer checks your flake inputs on its own, even with this view closed, and sends a desktop notification when there are updates you have not been told about.\n\nEnter switches it on or off. Needs systemd and notify-send (libnotify).\n' "$B" "$X" ;;
        interval) printf '%sCheck interval%s\n\n30m, 6h, 1d. Enter changes it; if checks are on they restart with the new interval.\n' "$B" "$X" ;;
        now) printf '%sCheck now%s\n\nRuns one check right away.\n' "$B" "$X" ;;
    esac
}
watch_act() {
    local cur new out
    case $1 in
        toggle)
            working 'Updating the timer'
            if [[ $("$NXD_CLI" --json watch status | jq -r .enabled) == true ]]; then new=off; else new=on; fi
            if out=$("$NXD_CLI" watch $new 2>&1); then printf '\n  %s✓%s %s\n' "$G" "$X" "$(tail -1 <<<"$out")"; sleep 1
            else printf '\n  %s✗%s %s\n' "$R" "$X" "$(tail -2 <<<"$out")"; sleep 3; fi ;;
        interval)
            clear
            cur=$("$NXD_CLI" --json watch status | jq -r .interval)
            printf '%sCheck every%s  %s(30m, 6h, 1d)%s\n\n' "$B" "$X" "$D" "$X"
            read -e -r -i "$cur" -p "  ❯ " new </dev/tty || return 0
            [[ $new == "$cur" ]] && return 0
            "$NXD_CLI" config set check_interval "$new" 2>&1 || { sleep 2; return 0; }
            [[ $("$NXD_CLI" --json watch status | jq -r .enabled) == true ]] && "$NXD_CLI" watch on >/dev/null 2>&1 ;;
        now) act watch run ;;
    esac
}
watch_screen() {
    fzf "${FZF_BASE[@]}" --with-nth 2 --no-sort --list-label ' Update checks ' --input-label ' Search ' --ghost 'option' \
        --header "$(header_cached)" --header-label ' System ' \
        --footer "$(keys 'Enter=change' 'Esc/⌫=back')" \
        --preview '$NXD_TUI _watchpv {1}' --preview-label ' About ' \
        --bind 'start:reload($NXD_TUI _watchrows)' \
        --bind 'enter:execute($NXD_TUI _watchact {1})+reload($NXD_TUI _watchrows)' \
        --bind 'backward-eof:abort' </dev/null >/dev/null
}

