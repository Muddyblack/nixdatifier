dev_rows() {
    "$NXD_CLI" --json dev list 2>/dev/null | jq -r --arg G "$G" --arg Y "$Y" --arg R "$R" --arg D "$D" --arg B "$B" --arg X "$X" --arg home "$HOME" '
        def hb: . as $n | if $n < 1024 then "\($n)B" else ((($n | log) / (1024 | log)) | floor | if . > 4 then 4 else . end) as $i
            | "\((($n / pow(1024; $i)) * 10 | round) / 10)\(["B","K","M","G","T"][$i])" end;
        .[] | "\(.dir)\t\(if .state == "allowed" then "\($G)●" elif .state == "denied" then "\($R)●" else "\($Y)●" end)\($X) \($B)\(.dir | sub("^" + $home; "~"))\($X)  \($D)\(.state)\($X)  \(.cacheBytes | hb)"'
}
# One project the way the widget shows it: the facts, the dev shells, and every
# flake input with the age of its lock (green: recent, yellow: a while, red: old).
dev_card() { # dev_card DIR [shells]; shells evaluates the flake (slow)
    local json flags=()
    [[ ${2:-} == shells ]] && flags=(--shells)
    json=$("$NXD_CLI" --json dev show "${flags[@]}" "$1" 2>/dev/null) || { echo "${R}could not read $1${X}"; return; }
    jq -r --arg G "$G" --arg R "$R" --arg Y "$Y" --arg D "$D" --arg B "$B" --arg P "$P" --arg X "$X" --argjson shells "$([[ ${2:-} == shells ]] && echo true || echo false)" '
        def ago($t): if ($t // 0) == 0 then "unknown" else
            (now - $t) as $s
            | if $s < 3600 then "just now" elif $s < 86400 then "\(($s / 3600) | floor)h ago"
              elif $s < 172800 then "yesterday"
              elif $s < 5184000 then "\(($s / 86400) | floor) days ago"
              else "\(($s / 2592000) | floor) months ago" end end;
        def tone($t): if ($t // 0) == 0 then $D elif (now - $t) < 2592000 then $G elif (now - $t) < 15552000 then $Y else $R end;
        def row($k; $v): "\($D)\($k | . + (" " * (20 - length)))\($X)\($v)";
        ([.inputs[].modified | select(. > 0)] | min) as $old
        | "\($B)\(.name)\($X)",
          (if .description != "" then "\($D)\(.description)\($X)" else empty end),
          "",
          row("direnv"; (if .envrc.state == "allowed" then "\($G)allowed\($X)" else "\($R)\(.envrc.state)\($X)" end) + (if .direnv != "" then " \($D)· \(.direnv)\($X)" else "" end)),
          (if (.envrc.uses | length) > 0 then row("Provides"; .envrc.uses | join(", ")) else empty end),
          row("Cached environment"; (if .cache.kb > 0 then "\(ago(.cache.mtime)) \($D)·\($X) \($Y)\(.cache.kb) KB\($X)" else "\($D)none\($X)" end)),
          row("Flake inputs"; (if (.inputs | length) > 0 then "\(.inputs | length)\(if $old then ", oldest locked \(tone($old))\(ago($old))\($X)" else "" end)" else "\($D)no flake\($X)" end)),
          row("Project files"; .files | join(", ")),
          row("Path"; .dir),
          (if $shells then "", "\($D)DEV SHELLS  \((.shells // []) | length)\($X)", ((.shells // [])[] | "  \($P)\(.)\($X)") else "", "\($D)Enter evaluates the dev shells (slow) and shows everything full screen.\($X)" end),
          (if (.inputs | length) > 0 then "", "\($D)FLAKE INPUTS  \(.inputs | length)\($X)",
            (.inputs[] | "  \($B)\(.name)\($X)  \(tone(.modified))\(ago(.modified))\($X)\n    \($D)\(.source) \(.ref) · \(.rev[:7])\(if .follows != "" then " · follows \(.follows)" else "" end)\($X)") else empty end)' <<<"$json"
}
