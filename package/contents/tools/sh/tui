    item quit '✕' "$D" Quit 'leave nixdatifier' 'Enter: quit'
}
home_preview() { # home_preview KEY
    local w=${FZF_PREVIEW_COLUMNS:-60} json
    case $1 in
        overview)
            overview_top "$w"
            echo
            printf '%s%sRecent generations%s\n' "$B" "$P" "$X"
            gen_rows | head -5 | cut -f2- ;;
        generations | compare) gen_rows | cut -f2- ;;
        settings) settings_rows | cut -f2- ;;
        about) about_card ;;
        diff)
            json=$(diff_json) || { echo "${R}diff failed${X}"; return; }
            change_summary "$json" 'newest vs previous'; echo; change_rows <<<"$json" | cut -f5 ;;
        updates) cli updates; echo; printf '%sEnter for every input, its release notes and updating it.%s\n' "$D" "$X" ;;
        history) history_rows | head -40 | cut -f2- ;;
        dev) dev_rows | cut -f2- ;;
        persist) cli persist status ;;
        profiles) prof_rows | cut -f2-; echo; cli profiles ;;
        disk)
            cli disk
            printf '\n%s%sCleaning up would%s %s(keeps the 5 newest generations and any younger than 14 days, never the running or booted one; then collects garbage)%s\n\n' "$B" "$Y" "$X" "$D" "$X"
            "$NXD_CLI" "${clr[@]}" --dry-run --yes clean 2>&1 | sed 's/^Nothing to delete\.$/No old generations to delete; garbage collection still frees what nothing uses./' ;;
        hash) printf '%sEnter, then paste what to hash:%s\n\n  a URL                 https://example.org/file.tar.gz\n  a local file          ./result.zip\n  a store path          /nix/store/…\n  a GitHub revision     owner/repo/v1.2.3\n\n%sFor an archive that fetchzip unpacks, use: nixdatifier hash zip URL%s\n' "$B" "$X" "$D" "$X" ;;
        quit) printf '\n  %sSee you.%s\n' "$D" "$X" ;;
        *) cli "$1" ;;
    esac
}
home_enter() { # home_enter KEY
    case $1 in
        overview) working Overview; home_preview overview | page Overview ;;
        generations) generations_screen ;;
        settings) settings_screen ;;
        about) working About; about_card fetch | page 'About' ;;
        compare) compare_screen ;;
        diff) changes_screen '' '' 'newest vs previous' ;;
        updates) updates_screen ;;
        history) history_screen ;;
        dev) dev_screen ;;
        persist) persist_screen ;;
        profiles) profile_screen ;;
        disk) disk_screen ;;
        hash) hash_flow ;;
        *) working "$1"; cli "$1" | page "$1" ;;
    esac
}
home() {
    fzf "${FZF_BASE[@]}" --with-nth 2 --no-sort --list-label ' nixdatifier ' --input-label ' Jump to ' \
        --ghost 'type to jump · Enter opens · Esc quits · F1 keys' \
        --header "$(header_cached)" --header-label ' System ' \
        --footer "$(keys 'Enter=open' 'Esc=quit' 'Ctrl-R=refresh' 'Alt-K=commands' 'Alt-P=preview' "Alt-C=colour:$THEME" "Alt-L=layout:$LAYOUT" 'F1=keys')" \
        --preview '$NXD_TUI _home {1}' \
        --bind 'focus:transform-preview-label(echo " "{3}" ")' \
        --bind 'start:bg-transform-header($NXD_TUI _header --updates)' \
        --bind 'enter:transform:[[ {1} == quit ]] && echo abort || echo "execute(\$NXD_TUI _enter {1})+refresh-preview+bg-transform-header(\$NXD_TUI _header)"' \
        --bind 'ctrl-r:execute-silent(rm -f "$NXD_STATE"/*.json)+refresh-preview+bg-transform-header($NXD_TUI _header --updates --refresh)' \
        --bind 'alt-k:execute($NXD_TUI _cmds)' \
        --bind 'alt-c:execute-silent($NXD_TUI _cycle theme)+abort,ctrl-t:execute-silent($NXD_TUI _cycle theme)+abort,f2:execute-silent($NXD_TUI _cycle theme)+abort' \
        --bind 'alt-l:execute-silent($NXD_TUI _cycle layout)+abort,ctrl-y:execute-silent($NXD_TUI _cycle layout)+abort,f3:execute-silent($NXD_TUI _cycle layout)+abort' \
        --bind 'click-footer:transform:case "$FZF_CLICK_FOOTER_WORD" in *preview*|Alt-P) echo toggle-preview ;; *colour*|Alt-C|Ctrl-T) echo "execute-silent(\$NXD_TUI _cycle theme)+abort" ;; *layout*|Alt-L|Ctrl-Y) echo "execute-silent(\$NXD_TUI _cycle layout)+abort" ;; *) $NXD_TUI _click "$FZF_CLICK_FOOTER_WORD" ;; esac' \
        --bind 'right-click:ignore' \
        --bind 'backward-eof:ignore' < <(home_rows) >/dev/null
    return 0
}

help_text() {
    printf '%s%sKeys%s\n\n' "$B" "$C" "$X"
    printf '  %-16s %s\n' 'Enter' 'open the highlighted item or run it' 'Esc' 'back (quits on the home screen)' \
        'Backspace' 'back, when the search is empty' 'type' 'filter the list' 'Ctrl-R' 'refresh' \
        'Alt-K' 'your commands and Rebuild (home screen)' 'Ctrl-A  Ctrl-U  Alt-U  Ctrl-D  Alt-G' 'Profiles: install, upgrade, upgrade all, remove, clean old versions' 'Alt-X' 'dismiss the updates banner' 'Alt-P  Ctrl-/' 'show or hide the preview (click it in the footer too)' 'Shift-↑↓' 'scroll the preview' 'Alt-↑↓' 'page the preview'
    printf '\n%s%sGenerations%s\n\n' "$B" "$P" "$X"
    printf '  %-16s %s\n' 'Enter' 'package changes of that generation' 'Tab' 'mark; two marks compare each other' \
        'Ctrl-O' 'compare against previous / booted / next boot' 'Ctrl-S  Ctrl-B' 'switch now / boot next time' \
        'Ctrl-D' 'delete the marked (or highlighted) generations'
    printf '\n%s%sWhat changed%s\n\n' "$B" "$P" "$X"
    printf '  %-16s %s\n' 'Tab' 'All → Added → Removed → Changed' 'Alt-A R C 0' 'jump to a filter (or click it)' 'Enter' 'store paths of the package'
    printf '\n%s%sUpdates%s\n\n' "$B" "$O" "$X"
    printf '  %-16s %s\n' 'Enter' 'packages the update would change' 'Ctrl-U  Alt-U' 'update this input / all inputs'
    printf '\n%sEverything that changes the system asks first and lands in History.%s\n' "$D" "$X"
}

# The fallback without a usable fzf: numbers or any command line.
numbered_menu() {
    local reply item words
    while :; do
        printf '\n%s%s❄ nixdatifier%s  %s\n\n' "$B" "$C" "$X" "$("$NXD_CLI" status "${clr[@]}" 2>/dev/null)"
        cat <<'MENU'
   1  Health            release, reboot needed, failed units
   2  Generations       what you can go back to
   3  Updates           flake inputs behind upstream
   4  What changed      newest generation vs previous
   5  Switch            pick a generation to run now
   6  Clean up          old generations and garbage
   r  Rebuild           run your rebuild command
   7  Disk              store size, what GC could free
   8  Dev environments  direnv projects and their cache
   9  History           what earlier changes did
   q  Quit              (or type any command, like: diff 3 2)
MENU
        read -r -p $'\n> ' reply || { echo; return 0; }
        case $reply in
            1) item=health ;; 2) item=generations ;; 3) item=updates ;; 4) item='diff' ;; 5) item=switch ;;
            6) item=clean ;; r | R) item=rebuild ;; 7) item=disk ;; 8) item='dev list' ;; 9) item=history ;;
            q | Q | quit | exit) return 0 ;;
            '') continue ;;
            *) item=$reply ;;
        esac
        read -r -a words <<<"$item"
        echo
        "$NXD_CLI" "${clr[@]}" "${words[@]}"
        read -r -p $'\n[Enter] back to the menu ' _ || return 0
    done
}
fzf_usable() {
    local v
    [[ -z ${NIXDATIFIER_NO_FZF:-} ]] && command -v fzf >/dev/null || return 1
    v=$(fzf --version 2>/dev/null | cut -d' ' -f1)
    [[ $(printf '%s\n%s\n' "$FZF_MIN" "$v" | sort -V | head -1) == "$FZF_MIN" ]]
}

# ── Endpoints for fzf, then the entry point ─────────────────────────────────
base_opts
case ${1:-} in
    _header) status_line "${@:2}" | tee "$NXD_STATE/header" ;;
    _home) home_preview "$2" ;;
    _enter) home_enter "$2" ;;
    _help) help_text ;;
    _cmds) commands_screen ;;
    _diskrows) disk_rows ;;
    _diskpv) disk_preview "$2" ;;
    _diskact) disk_act "$2" ;;
    _profrows) prof_rows ;;
    _profpv) prof_preview "$2" ;;
    _profadd) prof_install ;;
    _cmdrows) cmd_rows ;;
    _cmdrun) if [[ $2 == @rebuild ]]; then act rebuild; else act run "$2"; fi ;;
    _cmdpv) cmd_preview "$2" ;;
    _cmdadd) cmd_add ;;
    _watchrows) watch_rows ;;
    _watchpv) watch_preview "$2" ;;
    _watchact) watch_act "$2" ;;
    _setrows) settings_rows ;;
    _setpv) settings_preview "$2" ;;
    _setedit) settings_edit "$2" ;;
    _setclear) case $2 in theme | layout | @*) ;; *) "$NXD_CLI" config unset "$2" >/dev/null 2>&1 ;; esac ;;
    _click) # the fzf action for a footer word that was clicked: a key presses itself, "back" goes back
        w=${2//[$'\r\n ']/}
        case $w in
            Esc* | *⌫* | back) echo abort ;;
            'Ctrl-/') echo toggle-preview ;;
            # any key the footer names, so keys added later are clickable too
            Enter | Tab | Space | Home | End | Up | Down | PgUp | PgDn | F[0-9]* | Ctrl-* | Alt-* | Shift-*) echo "trigger(${w,,})" ;;
        esac ;;
    _fit) # _fit COLUMNS LINES: wide: preview on the right; tall but narrow: below; else hidden
        if (($2 >= 70)); then echo 'show-preview+change-preview-window(right,55%,wrap)'
        elif (($3 >= 32)); then echo 'show-preview+change-preview-window(bottom,40%,wrap)'
        else echo 'hide-preview'; fi ;;
    _cycle) cycle_conf "$2"; : >"$NXD_STATE/restart" ;;
    _devcard) dev_card "$2" ;;
    _devpage) working "$(basename "$2")"; dev_card "$2" shells | page "$(basename "$2")" ;;
    _cli) cli "${@:2}" ;;
    _page) title=$2; shift 2; working "$title"; cli "$@" | page "$title" ;;
    _pagein) page "$2" ;;
    _act) act "${@:2}" ;;
    _gens) gen_rows ;;
    _gendiff) gen_diff_preview "$2" ;;
    _compare) compare_open "${@:2}" ;;
    _opengen) open_generation "${@:2}" ;;
    _modelabel) mode_label "$(compare_mode)" ;;
    _cyclemode) next=$(case $(compare_mode) in prev) echo booted ;; booted) echo next ;; *) echo prev ;; esac); echo "$next" >"$NXD_STATE/mode" ;;
    _filter) filter_action "$2" ;;
    _changerows) changes_load ;;
    _changehead) changes_header ;;
    _paths) store_paths "$2" "${3:-}" "${4:-}" "${5:-}" ;;
    _inputs) input_rows "${@:2}" ;;
    _toggleall) if [[ -e $NXD_STATE/showall ]]; then rm -f "$NXD_STATE/showall"; else : >"$NXD_STATE/showall"; fi ;;
    _inputpv) input_preview "$2" "$3" ;;
    _inputpage) working "$2"; input_preview "$2" "$3" | page "$2" ;;
    _history) history_rows ;;
    _histpv) history_preview "$2" ;;
    _dev) dev_rows ;;
    _*) printf 'tui: unknown endpoint %s\n' "$1" >&2; exit 2 ;;
    *)
        [[ -t 0 && -t 1 ]] || { echo 'tui: needs a terminal (use nixdatifier commands in scripts)' >&2; exit 2; }
        if ! fzf_usable; then numbered_menu; exit 0; fi
        NXD_STATE=$(mktemp -d "${TMPDIR:-/tmp}/nixdatifier-tui.XXXXXX") || exit 1
        NXD_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/nixdatifier/tui
        mkdir -p "$NXD_CACHE" || NXD_CACHE=$NXD_STATE
        find "$NXD_CACHE" -name 'diff-*' -mtime +60 -delete 2>/dev/null
        export NXD_STATE NXD_CACHE
        # The scratch directory is in /tmp (often RAM): remove it however we end, and
        # sweep the ones a killed session left behind.
        trap 'rm -rf "$NXD_STATE"' EXIT
        trap 'exit 130' INT HUP TERM
        echo $$ >"$NXD_STATE/pid"
        for d in "${TMPDIR:-/tmp}"/nixdatifier-tui.*; do
            [[ -d $d && -O $d && $d != "$NXD_STATE" ]] || continue
            kill -0 "$(cat "$d/pid" 2>/dev/null)" 2>/dev/null || rm -rf "$d"
        done
        printf '%s❄ nixdatifier%s  %sstarting…%s\r' "$B$P" "$X" "$D" "$X"
        # F2/F3 change the look, which is read at start: leave fzf, start again.
        home
        if [[ -e $NXD_STATE/restart ]]; then
            rm -f "$NXD_STATE/restart"
            rm -rf "$NXD_STATE"
            exec "$NXD_TUI"
        fi ;;
esac
